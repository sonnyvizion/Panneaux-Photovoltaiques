---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LeadStatement from '../../components/LeadStatement.astro';
import Essentials from '../../components/Essentials.astro';
import TopicCards from '../../components/TopicCards.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Sun from '../../assets/icons/longevite/sun.svg';
import ChartLine from '../../assets/icons/longevite/chart-line.svg';
import CloudRain from '../../assets/icons/longevite/cloud-rain.svg';
import Refresh from '../../assets/icons/longevite/refresh.svg';
import heroImage from '../../assets/pages/4.7-longevite-hero.webp';
import {
  BRIDGES, ESSENTIALS_COPY, FACTS, FAQ, FIGURES, FINAL_CTA,
  HERO, LEAD, TOPICS, TOPICS_COPY,
} from '../../data/pages/comprendre-longevite';

/**
 * Page 4.7 — « Longévité ».
 *
 * Gabarit standard de famille E : aucun module, sur prescription du cahier.
 * Aucun composant nouveau — c'est le même assemblage que les quatorze autres
 * pages de cette famille déjà livrées.
 *
 * Photos et icônes du pilier livrées et branchées.
 */
---

<BaseLayout transparentHeader>
  <PageHero badge={HERO.badge} title={HERO.title} answer={HERO.answer} cta={HERO.cta} image={heroImage} imageAlt={HERO.imageAlt} />
  <LeadStatement text={LEAD.text} />
  <Essentials overline={ESSENTIALS_COPY.overline} title={ESSENTIALS_COPY.title} intro={ESSENTIALS_COPY.intro} figures={FIGURES} facts={FACTS} bridges={BRIDGES} />
  <TopicCards overline={TOPICS_COPY.overline} title={TOPICS_COPY.title} intro={TOPICS_COPY.intro} items={TOPICS.map((t, i) => ({ ...t, icon: [Sun, ChartLine, CloudRain, Refresh][i] }))} />
  <Faq items={FAQ} overline="Avant de vous décider" intro="Les questions qu'on nous pose le plus souvent sur la durée de vie." tone="grey" id="faq-longevite" />
  <FinalCta title={FINAL_CTA.title} text={FINAL_CTA.text} cta={FINAL_CTA.cta} tone="default" />
</BaseLayout>
