---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LeadStatement from '../../components/LeadStatement.astro';
import PhotonFlow from '../../components/PhotonFlow.astro';
import Essentials from '../../components/Essentials.astro';
import TopicCards from '../../components/TopicCards.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import Bolt from '../../assets/icons/fonctionnement/bolt.svg';
import Cloud from '../../assets/icons/fonctionnement/cloud.svg';
import Moon from '../../assets/icons/fonctionnement/moon.svg';
import Sunrise from '../../assets/icons/fonctionnement/sunrise.svg';
import heroImage from '../../assets/pages/4.1-fonctionnement-hero.webp';
import carteCellule from '../../assets/pages/4.1-fonctionnement-carte-cellule.webp';
import carteOnduleur from '../../assets/pages/4.1-fonctionnement-carte-onduleur.webp';
import carteCompteur from '../../assets/pages/4.1-fonctionnement-carte-compteur.webp';
import {
  PHOTOS, BRIDGES, ESSENTIALS_COPY, FACTS, FAQ, FIGURES, FINAL_CTA,
  FLOW, FLOW_COPY, HERO, LEAD, TOPICS, TOPICS_COPY,
} from '../../data/pages/comprendre-fonctionnement';

/**
 * Page 4.1 — « Fonctionnement des panneaux ».
 *
 * Seule instance de `PhotonFlow` (famille G, nouvelle) : le trajet lumière →
 * cellule → électron → courant → onduleur, révélé étape par étape au défilement.
 *
 * ⚠️ L'animation est en CSS pur (`animation-timeline: view()`), comme la classe
 * `.reveal` du site — pas d'`IntersectionObserver`, pas un octet de JavaScript.
 * Sans support, sans mouvement autorisé ou sans CSS, les cinq étapes restent
 * lisibles dans l'ordre.
 *
 * Photos et icônes du pilier livrées et branchées.
 */
---

<BaseLayout title="Comment fonctionne un panneau solaire ? | Belgreen" transparentHeader>
  <PageHero badge={HERO.badge} title={HERO.title} answer={HERO.answer} cta={HERO.cta} image={heroImage} imageAlt={HERO.imageAlt} />
  <LeadStatement text={LEAD.text} note={LEAD.note} />
  <PhotonFlow overline={FLOW_COPY.overline} title={FLOW_COPY.title} intro={FLOW_COPY.intro} steps={FLOW} />
  <Essentials overline={ESSENTIALS_COPY.overline} title={ESSENTIALS_COPY.title} intro={ESSENTIALS_COPY.intro} figures={FIGURES} facts={FACTS} bridges={BRIDGES} photos={PHOTOS.map((p, i) => ({ ...p, src: [carteCellule, carteOnduleur, carteCompteur][i] }))} />
  <TopicCards overline={TOPICS_COPY.overline} title={TOPICS_COPY.title} intro={TOPICS_COPY.intro} items={TOPICS.map((t, i) => ({ ...t, icon: [Bolt, Cloud, Moon, Sunrise][i] }))} />
  <Faq items={FAQ} overline="Avant de vous décider" intro="Les questions qu'on nous pose le plus souvent sur le fonctionnement." tone="default" id="faq-fonctionnement" />
  <FinalCta title={FINAL_CTA.title} text={FINAL_CTA.text} cta={FINAL_CTA.cta} tone="grey" />
</BaseLayout>
