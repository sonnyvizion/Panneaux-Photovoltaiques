---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LeadStatement from '../../components/LeadStatement.astro';
import FigureModule from '../../components/FigureModule.astro';
import Essentials from '../../components/Essentials.astro';
import TopicCards from '../../components/TopicCards.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import heroImage from '../../assets/pages/2.4-dimensions-hero.webp';
import Resize from '../../assets/icons/dimensions/resize.svg';
import Ruler from '../../assets/icons/dimensions/ruler-2.svg';
import ArrowsHorizontal from '../../assets/icons/dimensions/arrows-horizontal.svg';
import {
  BRIDGES, ESSENTIALS_COPY, FACTS, FAQ, FIGURES, FINAL_CTA,
  HERO, LEAD, MODULE, TOPICS, TOPICS_COPY,
} from '../../data/pages/installation-dimensions';

/**
 * Page 2.4 — « Dimensions ».
 *
 * ⚠️ Le cahier réunissait « Dimensions » et « Poids » sous une seule entrée de
 * sitemap (`/installation/dimensions-poids` dans `site.ts`) ; il en fait deux
 * pages distinctes, avec deux textes complets et deux jeux d'icônes. Ce sont
 * donc deux pages ici, et `site.ts` a été scindé en conséquence.
 */
---

<BaseLayout title="Dimensions des panneaux solaires : surface nécessaire | Belgreen" transparentHeader>
  <PageHero badge={HERO.badge} title={HERO.title} answer={HERO.answer} cta={HERO.cta} image={heroImage} imageAlt={HERO.imageAlt} />
  <LeadStatement text={LEAD.text} note={LEAD.note} />
  <FigureModule title={MODULE.title} caption={MODULE.caption} bridgeLabel={MODULE.bridgeLabel} cta={MODULE.cta} image={heroImage} />
  <Essentials overline={ESSENTIALS_COPY.overline} title={ESSENTIALS_COPY.title} intro={ESSENTIALS_COPY.intro} figures={FIGURES} facts={FACTS} bridges={BRIDGES} />
  <TopicCards overline={TOPICS_COPY.overline} title={TOPICS_COPY.title} intro={TOPICS_COPY.intro} items={TOPICS.map((t, i) => ({ ...t, icon: [Resize, Ruler, ArrowsHorizontal][i] }))} />
  <Faq items={FAQ} overline="Avant de vous décider" intro="Les questions qu'on nous pose le plus souvent sur la surface." tone="grey" id="faq-dimensions" />
  <FinalCta title={FINAL_CTA.title} text={FINAL_CTA.text} cta={FINAL_CTA.cta} tone="default" />
</BaseLayout>
