---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LeadStatement from '../../components/LeadStatement.astro';
import FigureModule from '../../components/FigureModule.astro';
import Essentials from '../../components/Essentials.astro';
import TopicCards from '../../components/TopicCards.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import heroImage from '../../assets/pages/2.18-pompe-a-chaleur-hero.webp';
import moduleImage from '../../assets/pages/2.18-pompe-a-chaleur-module.webp';
import stackedImage from '../../assets/pages/pompe-a-chaleur-liste.jpg';
import ArrowsMaximize from '../../assets/icons/pompe-a-chaleur/arrows-maximize.svg';
import Bolt from '../../assets/icons/pompe-a-chaleur/bolt.svg';
import Plus from '../../assets/icons/pompe-a-chaleur/plus.svg';
import {
  STACKED_ROWS, STACKED_IMAGE, BRIDGES, ESSENTIALS_COPY, FACTS, FAQ, FIGURES, FINAL_CTA,
  HERO, LEAD, MODULE, TOPICS, TOPICS_COPY,
} from '../../data/pages/installation-pompe-a-chaleur';
/** Page 2.18 — « Pompe à chaleur ». Schéma de flux non livré : légende porteuse. */
---
<BaseLayout title="Panneaux solaires et pompe à chaleur : la combinaison | Belgreen" transparentHeader>
  <PageHero badge={HERO.badge} title={HERO.title} answer={HERO.answer} cta={HERO.cta} image={heroImage} imageAlt={HERO.imageAlt} />
  <LeadStatement text={LEAD.text} note={LEAD.note} />
  <FigureModule title={MODULE.title} caption={MODULE.caption} bridgeLabel={MODULE.bridgeLabel} cta={MODULE.cta} image={moduleImage} imageAlt="Unité extérieure de pompe à chaleur contre une façade avec toiture solaire visible au-dessus" />
  <Essentials overline={ESSENTIALS_COPY.overline} title={ESSENTIALS_COPY.title} intro={ESSENTIALS_COPY.intro} figures={FIGURES} facts={FACTS} bridges={BRIDGES} stacked={{ rows: STACKED_ROWS, image: stackedImage, imageAlt: HERO.imageAlt, placeholder: STACKED_IMAGE }} />
  <TopicCards overline={TOPICS_COPY.overline} title={TOPICS_COPY.title} intro={TOPICS_COPY.intro} items={TOPICS.map((t, i) => ({ ...t, icon: [ArrowsMaximize, Bolt, Plus][i] }))} />
  <Faq items={FAQ} overline="Avant de vous décider" intro="Les questions qu'on nous pose le plus souvent sur cette combinaison." tone="grey" id="faq-pac" />
  <FinalCta title={FINAL_CTA.title} text={FINAL_CTA.text} cta={FINAL_CTA.cta} tone="default" />
</BaseLayout>
