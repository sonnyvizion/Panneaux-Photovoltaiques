---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LeadStatement from '../../components/LeadStatement.astro';
import SchemaPlate from '../../components/SchemaPlate.astro';
import Essentials from '../../components/Essentials.astro';
import TopicCards from '../../components/TopicCards.astro';
import Faq from '../../components/Faq.astro';
import FinalCta from '../../components/FinalCta.astro';
import heroImage from '../../assets/pages/2.3-puissance-hero.webp';
import stackedImage from '../../assets/pages/puissance-liste.jpg';
import Bolt from '../../assets/icons/puissance-kwc/bolt.svg';
import CalculatorIcon from '../../assets/icons/puissance-kwc/calculator.svg';
import TrendingUp from '../../assets/icons/puissance-kwc/trending-up.svg';
import {
  STACKED_ROWS, STACKED_IMAGE, BRIDGES, ESSENTIALS_COPY, FACTS, FAQ, FIGURES, FINAL_CTA,
  HERO, LEAD, TOPICS, TOPICS_COPY, SCHEMA,
} from '../../data/pages/installation-puissance';

/**
 * Page 2.3 — « Puissance (kWc) ».
 *
 * Module : AUCUN, et c'est voulu. Le `FigureModule` qui rejouait la photo du
 * hero faute de dessin a été retiré ; le schéma kWc/kWh demandé par le cahier
 * est livré, mais il se place sous « L'essentiel » (famille I, voir l'en-tête
 * de `SchemaPlate.astro`). Le créneau du module reste vide plutôt que d'être
 * rempli d'une photo décorative. Voir le commentaire du `SCHEMA` côté données.
 */
---

<BaseLayout transparentHeader>
  <PageHero badge={HERO.badge} title={HERO.title} answer={HERO.answer} cta={HERO.cta} image={heroImage} imageAlt={HERO.imageAlt} />
  <LeadStatement text={LEAD.text} note={LEAD.note} />
  <Essentials overline={ESSENTIALS_COPY.overline} title={ESSENTIALS_COPY.title} intro={ESSENTIALS_COPY.intro} figures={FIGURES} facts={FACTS} bridges={BRIDGES} stacked={{ rows: STACKED_ROWS, image: stackedImage, imageAlt: HERO.imageAlt, placeholder: STACKED_IMAGE }} />
  <SchemaPlate src={SCHEMA.src} alt={SCHEMA.alt} title={SCHEMA.title} caption={SCHEMA.caption} keys={[...SCHEMA.keys]} bridgeLabel={SCHEMA.bridgeLabel} cta={SCHEMA.cta} />
  <TopicCards overline={TOPICS_COPY.overline} title={TOPICS_COPY.title} intro={TOPICS_COPY.intro} items={TOPICS.map((t, i) => ({ ...t, icon: [Bolt, CalculatorIcon, TrendingUp][i] }))} />
  <Faq items={FAQ} overline="Avant de vous décider" intro="Les questions qu'on nous pose le plus souvent sur le kWc." tone="grey" id="faq-puissance" />
  <FinalCta title={FINAL_CTA.title} text={FINAL_CTA.text} cta={FINAL_CTA.cta} tone="default" />
</BaseLayout>
