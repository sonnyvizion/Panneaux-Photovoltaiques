---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Badge from '../components/Badge.astro';
import Card from '../components/Card.astro';
import Accordion from '../components/Accordion.astro';
---

<BaseLayout title="Design system — QA interne" noindex>
  <main class="ds">
    <section>
      <h2>Typographie</h2>
      <div class="ds__column">
        <h1>H1 — Titre de page (Circular Std Medium 44)</h1>
        <h2>H2 — Sous-titre de section (Circular Std Book 44)</h2>
        <h3>H3 — Sous-titre mineur (Circular Std Medium 22)</h3>
        <h4>H4 — Titre de bloc (Circular Std Medium 26)</h4>
        <p>Corps de texte en Inter Medium 16/20, pour vérifier la lisibilité.</p>
        <p class="ds__muted">Texte secondaire (--color-text-muted), taille --text-body-nav-size.</p>
        <p class="ds__mono">3 240 € / an — Geist Mono 500</p>
      </div>
    </section>

    <section>
      <h2>Boutons</h2>
      <div class="ds__row">
        <Button variant="primary">Action principale</Button>
        <Button variant="secondary">Action secondaire</Button>
      </div>
    </section>

    <section>
      <h2>Badges</h2>
      <div class="ds__row ds__row--dark">
        <Badge variant="glass">Gratuit</Badge>
        <Badge variant="solid">Sans engagement</Badge>
      </div>
    </section>

    <section>
      <h2>Carte</h2>
      <div class="ds__row">
        <Card>
          <h3>Titre de carte</h3>
          <p>Contenu de démonstration pour vérifier le radius, le filet et le padding.</p>
        </Card>
      </div>
    </section>

    <section>
      <h2>Accordéon</h2>
      <Accordion question="Est-ce que ça marche sans JavaScript ?">
        Oui — c'est un élément natif <code>&lt;details&gt;</code>/<code>&lt;summary&gt;</code>.
      </Accordion>
      <Accordion question="Deuxième question de test">
        Contenu de la deuxième réponse, pour vérifier l'empilement de plusieurs accordéons.
      </Accordion>
    </section>
  </main>
</BaseLayout>

<style>
  .ds {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-96) var(--space-24);
    display: flex;
    flex-direction: column;
    gap: var(--space-96);
  }

  .ds__row {
    display: flex;
    gap: var(--space-24);
    align-items: center;
    flex-wrap: wrap;
  }

  .ds__row--dark {
    background: var(--color-white-clear);
    padding: var(--space-24);
    border-radius: var(--radius-4);
  }

  .ds__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .ds__muted {
    color: var(--color-text-muted);
    font-size: var(--text-body-nav-size);
  }

  .ds__mono {
    font-family: var(--font-family-mono);
    font-weight: var(--font-weight-medium);
  }
</style>
