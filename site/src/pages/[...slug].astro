---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import { PILLARS, PRIMARY_CTA, type NavLink } from '../data/site';

/**
 * Chantier temporaire — à supprimer quand les pages réelles seront écrites.
 *
 * La nav ne montre que ce qui est marqué `published` (voir `site.ts`), mais un
 * lien publié doit mener quelque part : sans cette route, la refonte de la nav
 * livrerait des 404 dans le header, exactement ce que le drapeau doit empêcher.
 *
 * Elle génère un placeholder pour chaque destination annoncée qui n'a pas encore
 * son fichier. La liste est DÉRIVÉE de `site.ts` : impossible qu'elle dérive de
 * l'arborescence. Dès qu'une vraie page est créée, Astro lui donne la priorité
 * sur cette route attrape-tout — il suffit de l'ajouter à `REAL_PAGES`.
 *
 * Toutes sont en `noindex` : une page vide indexée coûte plus cher qu'une page
 * absente (règle d'or #1).
 */

export function getStaticPaths() {
  /* Pages qui ont déjà leur propre fichier — à ne pas générer ici. Déclaré
     dans la fonction : Astro isole `getStaticPaths`, qui ne voit pas les
     constantes du frontmatter. */
  const REAL_PAGES = [
    '/',
    '/a-propos',
    '/realisations',
    '/contact',
    '/design-system',
    '/simulateur',
    '/devis',
    '/etude',
    '/rapport',
    '/rentabilite-prix',
    '/rentabilite-prix/rendement',
    '/rentabilite-prix/amortissement',
    '/rentabilite-prix/autoconsommation',
    '/aides-primes/wallonie',
    '/aides-primes/wallonie/prosumer',
    '/aides-primes/wallonie/demarches',
    '/aides-primes/flandre/demarches',
    '/aides-primes/bruxelles/reglementation',
    '/aides-primes/entreprises',
    '/aides-primes/copropriete',
    '/aides-primes/bruxelles',
    '/aides-primes/bruxelles/demarches',
    '/aides-primes/flandre',
    '/aides-primes/flandre/compteur-inverse',
    '/installation/nombre-de-panneaux',
    '/installation/puissance',
    '/installation/dimensions',
    '/installation/poids',
    '/installation/ombrage',
    '/installation/fixation',
    '/installation/toit-plat',
    '/installation/bipv',
    '/installation/abri-de-jardin',
    '/installation/carport',
    '/installation/balcon',
    '/installation/camping-car',
    '/installation/trouver-un-installateur',
    '/installation/soi-meme',
    '/installation/pompe-a-chaleur',
    '/installation/voiture-electrique',
    '/comprendre/fonctionnement',
    '/comprendre/types-de-panneaux',
    '/comprendre/onduleur',
    '/comprendre/batterie',
    '/comprendre/compteur-intelligent',
    '/comprendre/borne-de-recharge',
    '/comprendre/longevite',
    '/comprendre/garanties',
    '/comprendre/maintenance',
    '/comprendre/impact-ecologique',
    '/comprendre/risques-inconvenients',
  ];

  const destinations: NavLink[] = [
    PRIMARY_CTA,
    ...PILLARS.flatMap((pillar) => [
      pillar,
      ...pillar.groups.flatMap((group) => group.links.filter((link) => link.published)),
    ]),
  ];

  const seen = new Set(REAL_PAGES);

  return destinations
    .filter((link) => {
      if (seen.has(link.href)) return false;
      seen.add(link.href);
      return true;
    })
    .map((link) => ({
      params: { slug: link.href.replace(/^\//, '') },
      props: { label: link.label },
    }));
}

const { label } = Astro.props;
---

<BaseLayout title={`${label} — Belgreen`} noindex>
  <Section>
    <h1>{label}</h1>
    <p>Page en cours de rédaction.</p>
  </Section>
</BaseLayout>
