---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import LeadStatement from '../../../components/LeadStatement.astro';
import StateToggle from '../../../components/StateToggle.astro';
import Essentials from '../../../components/Essentials.astro';
import TopicCards from '../../../components/TopicCards.astro';
import Faq from '../../../components/Faq.astro';
import FinalCta from '../../../components/FinalCta.astro';
import heroImage from '../../../assets/pages/1.8-fin-compteur-inverse-flandre-hero.webp';
import Scale from '../../../assets/icons/compteur-inverse/scale.svg';
import ReceiptOff from '../../../assets/icons/compteur-inverse/receipt-off.svg';
import Progress from '../../../assets/icons/compteur-inverse/progress.svg';
import Ban from '../../../assets/icons/compteur-inverse/ban.svg';
import {
  ASIDE, BRIDGES, ESSENTIALS_COPY, FACTS, FAQ, FIGURES, FINAL_CTA,
  HERO, LEAD, TOGGLE_COPY, TOGGLE_STATES, TOPICS, TOPICS_COPY,
} from '../../../data/pages/aides-primes-flandre-compteur-inverse';

/**
 * Page 1.8 du cahier — « Fin du compteur inversé en Flandre ».
 *
 * Première instance de `StateToggle` (famille C). La bascule démarre sur
 * « Avant 2021 » : le visiteur arrive avec la croyance que le compteur tourne à
 * l'envers, la page doit d'abord lui montrer ce qu'il croit, puis ce qui l'a
 * remplacé. Démarrer sur l'état actuel lui ferait rater la comparaison.
 *
 * Photo de hero livrée et branchée.
 */
const TOPIC_ICONS = [Scale, ReceiptOff, Progress, Ban];
const topics = TOPICS.map((topic, index) => ({ ...topic, icon: TOPIC_ICONS[index] }));
---

<BaseLayout transparentHeader>
  <PageHero badge={HERO.badge} title={HERO.title} answer={HERO.answer} cta={HERO.cta} image={heroImage} imageAlt={HERO.imageAlt} />
  <LeadStatement text={LEAD.text} note={LEAD.note} />
  <StateToggle
    overline={TOGGLE_COPY.overline}
    title={TOGGLE_COPY.title}
    intro={TOGGLE_COPY.intro}
    states={TOGGLE_STATES}
    selected={0}
    id="bascule-compteur"
  />
  <Essentials overline={ESSENTIALS_COPY.overline} title={ESSENTIALS_COPY.title} intro={ESSENTIALS_COPY.intro} figures={FIGURES} facts={FACTS} bridges={BRIDGES} aside={ASIDE} />
  <TopicCards overline={TOPICS_COPY.overline} title={TOPICS_COPY.title} intro={TOPICS_COPY.intro} items={topics} />
  <Faq items={FAQ} overline="Avant de vous décider" intro="Les questions qu'on nous pose le plus souvent sur ce changement." tone="default" id="faq-compteur-inverse" />
  <FinalCta title={FINAL_CTA.title} text={FINAL_CTA.text} cta={FINAL_CTA.cta} tone="grey" />
</BaseLayout>
