---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import LeadStatement from '../../../components/LeadStatement.astro';
import StepsTimeline from '../../../components/StepsTimeline.astro';
import Faq from '../../../components/Faq.astro';
import FinalCta from '../../../components/FinalCta.astro';
import heroImage from '../../../assets/pages/1.9-demarches-flandre-hero.webp';
import Gauge from '../../../assets/icons/demarches-flandre/gauge.svg';
import Send from '../../../assets/icons/demarches-flandre/send.svg';
import Bolt from '../../../assets/icons/demarches-flandre/bolt.svg';
import {
  FAQ,
  FINAL_CTA,
  HERO,
  LEAD,
  TIMELINE,
  TIMELINE_COPY,
} from '../../../data/pages/aides-primes-flandre-demarches';

/**
 * Page 1.9 du cahier de construction — « Démarches administratives Flandre ».
 *
 * Jumelle de `wallonie/demarches.astro` : même gabarit allégé, même composant de
 * timeline, seul le fichier de données change. C'est le résultat visé par le
 * registre des modules — la troisième page « Démarches » (Bruxelles) n'aura rien
 * de plus à coder non plus.
 */

const TIMELINE_ICONS = [Gauge, Send, Bolt];
const steps = TIMELINE.map((step, index) => ({ ...step, icon: TIMELINE_ICONS[index] }));
---

<BaseLayout
  title="Démarches panneaux solaires Flandre : compteur digital et Fluvius | Belgreen"
  transparentHeader
>
  <PageHero
    badge={HERO.badge}
    title={HERO.title}
    answer={HERO.answer}
    cta={HERO.cta}
    image={heroImage}
    imageAlt={HERO.imageAlt}
  />

  <LeadStatement text={LEAD.text} note={LEAD.note} />

  <StepsTimeline
    overline={TIMELINE_COPY.overline}
    title={TIMELINE_COPY.title}
    intro={TIMELINE_COPY.intro}
    steps={steps}
  />

  <Faq
    items={FAQ}
    overline="Avant de vous décider"
    intro="Les questions qu'on nous pose le plus souvent sur ces démarches."
    tone="default"
    id="faq-demarches-flandre"
  />

  <FinalCta
    title={FINAL_CTA.title}
    text={FINAL_CTA.text}
    cta={FINAL_CTA.cta}
    tone="grey"
  />
</BaseLayout>
