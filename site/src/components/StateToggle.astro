---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import type { SectionCopy, ToggleState } from '../data/content';

/**
 * Bascule à deux états — famille C du registre des modules.
 *
 * « Avant / après » : deux mécanismes qui se remplacent, montrés l'un à la place
 * de l'autre plutôt que l'un sous l'autre. C'est la règle d'or #4 — une
 * substitution se manipule, elle ne se lit pas dans deux paragraphes qu'il
 * faudrait comparer de mémoire.
 *
 * ⚠️ ZÉRO JAVASCRIPT. Boutons radio + `:has()`, comme le comparateur et
 * l'accordéon natif. La transition douce demandée par la rédaction est une
 * transition CSS d'opacité, pas une animation scriptée.
 *
 * ⚠️ LES DEUX ÉTATS SONT DANS LE HTML, toujours. Le panneau caché l'est par
 * `visibility`/`position`, jamais par `display: none` sur du contenu unique :
 * les deux textes doivent rester indexables (règle d'or #1). Ce module explique
 * un changement de réglementation — c'est précisément le texte que les moteurs
 * doivent trouver.
 */
interface Props extends SectionCopy {
  /** Exactement deux états. Le premier est affiché au chargement. */
  states: [ToggleState, ToggleState];
  /** Nom du groupe de radios. Unique par page. */
  id?: string;
  /** Index de l'état affiché au chargement. */
  selected?: 0 | 1;
}

const { overline, title, intro, states, id = 'bascule', selected = 0 } = Astro.props;
---

<Section tone="grey" id={id}>
  <SectionHeading overline={overline} overlineTone="tertiary" title={title} intro={intro} />

  <div class="toggle reveal">
    <fieldset class="toggle__options">
      <legend class="visually-hidden">Période à afficher</legend>
      <div class="toggle__options-grid">
        {states.map((state, index) => (
          <label class="toggle__option">
            <input
              class="toggle__option-input"
              type="radio"
              name={`${id}-state`}
              value={index}
              checked={index === selected}
            />
            <span class="toggle__option-label">{state.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    {/* Les deux panneaux sont empilés dans la même case de grille : le conteneur
        garde donc la hauteur du plus grand, et rien ne saute au basculement. */}
    <div class="toggle__stack">
      {states.map((state) => (
        <article class="toggle__panel">
          <h3 class="toggle__title">{state.title}</h3>
          {state.highlight && <p class="toggle__highlight">{state.highlight}</p>}
          <p class="toggle__text">{state.text}</p>
        </article>
      ))}
    </div>
  </div>
</Section>

<style>
  .toggle {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--width-timeline);
    margin-inline: auto;
    padding: var(--pad-card-lg-block);
    border-radius: var(--radius-panel);
    background: var(--color-white-primary);
  }

  .toggle__options {
    padding: 0;
    margin: 0;
    border: 0;
    min-inline-size: 0;
  }

  .toggle__options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
    padding: var(--space-2);
    border-radius: var(--radius-card);
    background: var(--color-white-clear);
  }

  .toggle__option {
    display: flex;
    min-width: 0;
  }

  .toggle__option-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .toggle__option-label {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-card);
    cursor: pointer;
    text-align: center;
    background: var(--color-white-primary);
    color: var(--color-text-primary);
    font-family: var(--text-h4-family);
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
    line-height: var(--text-h4-line-height);
    letter-spacing: var(--text-h4-tracking);
    transition: background-color var(--duration-fast) var(--easing-default);
  }

  .toggle__option-input:checked + .toggle__option-label {
    background: var(--color-highlight-primary);
  }

  .toggle__option-input:focus-visible + .toggle__option-label {
    outline: var(--focus-ring-width) solid var(--color-ink-900);
    outline-offset: var(--focus-ring-offset);
  }

  /* Les deux panneaux occupent LA MÊME case : la hauteur du conteneur est celle
     du plus grand des deux, et le bloc ne saute pas au basculement. */
  .toggle__stack {
    display: grid;
  }

  .toggle__panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--pad-card);
    border-radius: var(--radius-card);
    background: var(--color-white-clear);
    /* ⚠️ Masquage par `visibility` et non `display: none` : le texte des deux
       états doit rester dans le document pour être indexé (règle d'or #1). */
    visibility: hidden;
    opacity: 0;
    transition: opacity var(--duration-medium) var(--easing-expand),
      visibility var(--duration-medium) var(--easing-expand);
  }

  /* Le panneau visible est celui dont le bouton, à la même position, est coché.
     Sélection par POSITION et non par id : l'id vient d'une prop, la position
     est une propriété du composant. */
  .toggle:has(.toggle__option:nth-child(1) input:checked) .toggle__panel:nth-child(1),
  .toggle:has(.toggle__option:nth-child(2) input:checked) .toggle__panel:nth-child(2) {
    visibility: visible;
    opacity: 1;
  }

  .toggle__title {
    margin: 0;
    font-family: var(--text-h4-family);
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
    line-height: var(--text-h4-line-height);
    letter-spacing: var(--text-h4-tracking);
  }

  /* La formule frappante du mécanisme : « 1 kWh injecté = 1 kWh déduit ». C'est
     elle qu'on retient, elle mérite le corps display. */
  .toggle__highlight {
    font-family: var(--text-display-mid-family);
    font-size: var(--text-h3-size);
    font-weight: var(--text-display-mid-weight);
    line-height: 1.1;
    letter-spacing: var(--text-display-mid-tracking);
  }

  .toggle__text {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
    font-weight: var(--text-body-light-weight);
    line-height: var(--text-body-light-line-height);
    letter-spacing: var(--text-body-light-tracking);
  }

  @media (max-width: 767px) {
    .toggle {
      padding: var(--space-12);
      gap: var(--space-3);
    }

    .toggle__option-label {
      padding: var(--space-3) var(--space-1);
      font-size: var(--text-body-sm-size);
    }
  }

  /* Le basculement est instantané quand le visiteur a demandé moins de
     mouvement — `global.css` neutralise le reste du site de la même façon. */
  @media (prefers-reduced-motion: reduce) {
    .toggle__panel {
      transition: none;
    }
  }
</style>
