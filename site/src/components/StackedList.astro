---
import { Image } from 'astro:assets';
import type { StackedRow } from '../data/content';

/**
 * Liste empilée à média fixe — famille H du registre des modules.
 *
 * Une colonne de lignes qui défilent, une seule photo qui reste en place à côté.
 * Motif emprunté à sharplink.com, adapté au système du site.
 *
 * ⚠️ UNE PHOTO POUR TOUTE LA LISTE, pas une par ligne. C'est ce qui distingue
 * ce module des cartes photo de « L'essentiel » : là-bas trois objets
 * différents, ici trois facettes d'un même sujet. Une image par ligne
 * suggérerait trois choses là où il n'y en a qu'une.
 *
 * ⚠️ IL NE PORTE PAS SA `<Section>`. Il rend son contenu et rien d'autre, pour
 * pouvoir se composer — c'est ainsi qu'il s'insère dans « L'essentiel » à la
 * place de la grille de cartes, sans y ajouter un second en-tête. Une page qui
 * l'emploierait seul le pose dans sa propre `<Section>`.
 *
 * ⚠️ ZÉRO JAVASCRIPT. Le maintien de la photo est un `position: sticky`, pas un
 * observateur de défilement. Sur une page dont les Core Web Vitals conditionnent
 * tout le trafic (règle d'or #1), un module décoratif ne réveille pas le fil
 * principal.
 */
interface Props {
  rows: StackedRow[];
  /** UNE image pour toute la liste. Le hero de la page, recadré en vertical. */
  image: ImageMetadata;
  imageAlt: string;
}

const { rows, image, imageAlt } = Astro.props;
---

<div class="stacked">
  {/* `<ol>` et non `<ul>` : les trois lignes se lisent dans l'ordre, du rôle à
      l'installation. La numérotation visible est retirée, l'ordre reste. */}
  <ol class="stacked__rows">
    {rows.map((row) => (
      <li class="stacked__row">
        <p class="stacked__eyebrow">{row.eyebrow}</p>
        <h3 class="stacked__title">{row.title}</h3>
        <p class="stacked__text">{row.text}</p>
      </li>
    ))}
  </ol>

  <div class="stacked__media">
    {/* ⚠️ Le hero de la page, RECADRÉ EN CSS — aucune image n'est produite pour
        ce module. `object-fit: cover` sur un cadre vertical prend la bande
        centrale d'une photo panoramique. */}
    <Image
      class="stacked__image"
      src={image}
      alt={imageAlt}
      width={1280}
      widths={[480, 768, 1280]}
      sizes="(min-width: 1024px) 420px, 100vw"
      loading="lazy"
    />
  </div>
</div>

<style>
  /* ⚠️ MOBILE D'ABORD : une seule colonne, la photo au-dessus de la liste.
     Les deux colonnes n'arrivent qu'à 1024px — pas 768. En dessous, la colonne
     de texte tombe sous 340px et les titres cassent sur trois lignes chacun,
     ce qui annule le rythme que ce module existe pour créer. */
  .stacked {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-4);
  }

  .stacked__rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ⚠️ LE FILET EST SUR LE HAUT, PAS SUR LE BAS. Posé en bas, il faut ensuite
     le retirer du dernier élément — et il réapparaît dès qu'on ajoute une
     ligne. Sur le haut, la première ligne s'en passe naturellement. */
  .stacked__row + .stacked__row {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border-width) dotted var(--color-shade-strong);
  }

  .stacked__eyebrow {
    margin-bottom: var(--space-2);
    color: var(--color-text-tertiary);
    font-family: var(--text-marker-family);
    font-size: var(--text-marker-size);
    font-weight: var(--text-marker-weight);
    line-height: var(--text-marker-line-height);
    /* La chasse est POSITIVE dans ce style — le seul du système. C'est ce qui
       rend les capitales lisibles ; sans elle, elles se collent. */
    letter-spacing: var(--text-marker-tracking);
    text-transform: uppercase;
  }

  .stacked__title {
    margin-bottom: var(--space-3);
    font-family: var(--text-h3-family);
    font-size: var(--text-h3-size);
    font-weight: var(--text-h3-weight);
    line-height: var(--text-h3-line-height);
    letter-spacing: var(--text-h3-tracking);
  }

  .stacked__text {
    color: var(--color-text-tertiary);
    font-family: var(--text-petit-p-m-family);
    font-size: var(--text-petit-p-m-size);
    font-weight: var(--text-petit-p-m-weight);
    line-height: var(--text-petit-p-m-line-height);
    letter-spacing: var(--text-petit-p-m-tracking);
  }

  .stacked__image {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-figure-card);
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .stacked {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--gap-cards);
    }

    /* ⚠️ LES LIGNES SE RÉPARTISSENT SUR LA HAUTEUR DE LA PHOTO. Avec trois
       lignes courtes, la colonne de texte mesure 442px contre 560 à la photo :
       elle s'arrêtait 118px plus haut, laissant un vide qui n'avait l'air de
       rien d'autre qu'un oubli. Étirée et distribuée, la dernière ligne tombe
       sur le bas de l'image. */
    .stacked__rows {
      display: flex;
      flex: 1;
      flex-direction: column;
      justify-content: space-between;
      align-self: stretch;
      min-width: 0;
    }

    /* ⚠️ `align-self: flex-start` EST OBLIGATOIRE. Un élément de flex est étiré
       par défaut : sa hauteur égale celle de la rangée, il n'a donc aucune
       marge de manœuvre et le `sticky` ne colle jamais. Le symptôme trompe —
       la règle est bien appliquée, elle n'a simplement rien à faire. */
    .stacked__media {
      flex: 0 0 var(--width-stacked-media);
      align-self: flex-start;
      position: sticky;
      top: var(--top-stacked-media);
    }

    /* Format vertical : la photo accompagne toute la liste, elle doit en tenir
       la hauteur sans l'imposer. */
    .stacked__image {
      aspect-ratio: var(--ratio-stacked-media);
    }
  }

  /* Le maintien de la photo est un confort, pas une information : qui demande
     moins de mouvement la voit défiler avec le reste. */
  @media (prefers-reduced-motion: reduce) {
    .stacked__media {
      position: static;
    }
  }
</style>
