---
import Button from './Button.astro';
import type { ContentLink } from '../data/content';

/**
 * Dernière relance vers le simulateur pour qui a tout scrollé
 * (architecture.md). Sur une page de contenu, l'accroche est contextualisée au
 * sujet lu — jamais un CTA générique (règle d'or : la boucle contenu ↔
 * simulateur, `pages-contenu.md`).
 */
interface Props {
  overline?: string;
  title: string;
  text?: string;
  /**
   * Le bouton du pont.
   *
   * ⚠️ `null` retire le bouton et laisse une simple clôture. C'est le cas de la
   * page « Camping-car », dont le cahier prescrit un pont « léger/optionnel » :
   * ce public n'est pas la cible du funnel devis résidentiel, et l'y envoyer
   * produirait un lead inexploitable. Une valeur ABSENTE, elle, garde le CTA par
   * défaut — les deux cas doivent rester distinguables.
   */
  cta?: ContentLink | null;
  /**
   * Fond de la bande qui porte la carte verte. Gris sur la home, où le bloc
   * prolonge la FAQ grise ; blanc sur les pages de contenu, dont la FAQ est
   * déjà blanche (Figma 466:1492).
   */
  tone?: 'grey' | 'default';
  /**
   * ⚠️ LA BANDE SE SOUDE AU BLOC PRÉCÉDENT — marge haute supprimée.
   *
   * Réservé aux pages dont le bloc du dessus est DÉJÀ GRIS : le gris continu
   * porte alors l'écart à lui seul (la home, et elle seule aujourd'hui). Sous un
   * bloc blanc, la soudure fait démarrer le gris au ras de la carte verte — on
   * ne voit plus qu'un liseré de 2px dans l'arrondi des angles.
   */
  soude?: boolean;
}

const {
  overline = "Passez à l'action",
  title,
  text = "Vous parlez directement à l'équipe qui installe. Pas d'intermédiaire. Pas de revente de données.",
  cta = { label: 'Faire mon estimation', href: '/simulateur' } as ContentLink | null,
  tone = 'grey',
  soude = false,
} = Astro.props;
---

<section class={`final-cta final-cta--${tone}${soude ? ' final-cta--soude' : ''}`}>
  <div class="final-cta__card reveal">
    <p class="final-cta__overline">{overline}</p>
    {/* Interpolation simple, jamais `set:html` : ce texte viendra de Sanity.
        Les espaces insécables sont écrits en U+00A0 dans les données. */}
    <h2 class="final-cta__title">{title}</h2>
    <p class="final-cta__text">{text}</p>
    {cta && (
      <div class="final-cta__action">
        <Button variant="ink" href={cta.href}>{cta.label}</Button>
      </div>
    )}
  </div>
</section>

<style>
  /* ⚠️ LA MARGE HAUTE EST LE DÉFAUT, ET C'EST L'INVERSE D'AVANT.

     Elle était à zéro pour tout le monde, `--default` la reposant ensuite. Or le
     défaut du prop `tone` est `grey` : neuf pages de contenu se retrouvaient
     donc soudées à leur FAQ BLANCHE, la bande grise démarrant au ras de la carte
     verte — un liseré de 2px dans l'arrondi des angles, et rien d'autre. Mesuré
     au navigateur : écart bande → carte de 0px sur /comprendre/fonctionnement,
     /installation/ombrage, /installation/trouver-un-installateur,
     /rentabilite-prix/amortissement, /aides-primes/flandre (+ ses deux
     sous-pages), /aides-primes/bruxelles/demarches et
     /aides-primes/wallonie/demarches.

     La soudure passe donc sur `soude`, où elle se demande explicitement. */
  .final-cta {
    padding: var(--section-padding-block) var(--container-padding);
  }

  /* Les deux tons peignent le même gris depuis que la bande a cessé d'être
     blanche sur les pages de contenu (b1e4b05) : `tone` ne décide plus de rien
     à l'écran. Les deux sélecteurs restent, les 43 pages qui les passent aussi. */
  .final-cta--grey,
  .final-cta--default {
    background: var(--color-shade-grey);
  }

  /* Le gris du bloc précédent porte l'écart à lui seul — voir le prop `soude`. */
  .final-cta--soude {
    padding-top: 0;
  }

  .final-cta__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: var(--container-max);
    margin-inline: auto;
    padding: var(--pad-card-lg-block);
    border-radius: var(--radius-panel);
    background: var(--color-main-green);
    color: var(--color-text-primary);
  }

  .final-cta__overline {
    margin: 0;
    font-family: var(--text-marker-family);
    font-size: var(--text-marker-size);
    font-weight: var(--text-marker-weight);
    line-height: var(--text-marker-line-height);
    letter-spacing: var(--text-marker-tracking);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .final-cta__title {
    margin: 0;
    max-width: var(--width-section-intro);
    font-family: var(--text-display-mid-family);
    font-size: var(--text-display-mid-size);
    font-weight: var(--text-display-mid-weight);
    line-height: var(--text-display-mid-line-height);
    letter-spacing: var(--text-display-mid-tracking);
  }

  /* Figma pose du display-little (Circular Book 22) : passé en texte courant,
     comme la carte équipe et la réponse FAQ. */
  .final-cta__text {
    margin: 0;
    max-width: var(--width-section-intro);
    color: var(--color-text-secondary);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-sm-size);
    font-weight: var(--text-body-light-weight);
    line-height: var(--text-body-sm-line-height);
    letter-spacing: var(--text-body-light-tracking);
  }

  /* Aligné à gauche sur mobile (Figma 466:1961), à droite en pied de carte dès
     1024px. Le bouton suit le fer du texte tant que la carte est une colonne ;
     il ne passe de l'autre côté que quand elle devient une grille à deux
     colonnes et que le texte lui laisse la place. */
  .final-cta__action {
    display: flex;
    justify-content: flex-start;
    margin-top: var(--space-3);
  }

  @media (min-width: 768px) {
    .final-cta__text {
      font-size: var(--text-body-light-size);
      line-height: var(--text-body-light-line-height);
    }
  }

  @media (min-width: 1024px) {
    /* `align-items: start` plutôt que `center` : le texte se cale en haut, le
       bouton descend seul en pied de carte via son `align-self`. Avec un
       centrage global, il restait à mi-hauteur. */
    /* Les trois lignes sont déclarées explicitement : sans elles, la grille
       n'a que des lignes implicites et `grid-row: 1 / -1` ne s'étend sur rien
       — `-1` ne désigne que la fin de la grille explicite. Le bouton restait
       collé à la première ligne. */
    .final-cta__card {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto auto;
      align-items: start;
      column-gap: var(--space-4);
      padding: var(--space-4) var(--space-4);
    }

    .final-cta__overline,
    .final-cta__title,
    .final-cta__text {
      grid-column: 1;
    }

    /* Bas à droite, comme dans Figma (nœud 356:500 : items-end + justify-end). */
    .final-cta__action {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: end;
      justify-self: end;
      margin-top: 0;
    }
  }
</style>
