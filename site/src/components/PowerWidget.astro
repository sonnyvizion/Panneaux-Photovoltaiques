---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import {
  POWER_DEFAULT,
  POWER_MAX,
  POWER_MIN,
  POWER_STEP,
  estimate,
  formatEuro,
  formatNumber,
  formatPower,
  powerRatio,
} from '../scripts/powerEstimate';
import { gaugeRatio } from '../scripts/powerWidget';
import type { ContentLink } from '../data/content';

/**
 * Module « Puissance installée » — la brique interactive de la page prix
 * (Figma 466:1368, nœud aplati : gabarit mesuré sur le rendu).
 *
 * ⚠️ Ce n'est PAS un second simulateur (règle d'or #3). Il ne demande rien au
 * visiteur, ne connaît ni sa région ni sa consommation, et ne retient rien. Il
 * répond à une seule question — « qu'est-ce qui se passe si je change la
 * puissance ? » — et renvoie au simulateur pour le reste.
 *
 * C'est le cas d'école de la règle d'or #4 : la relation entre puissance et
 * prix est une variable, donc un curseur, pas un tableau ni un pavé.
 *
 * ⚠️ Rendu complet SANS JavaScript (règle d'or #1) : l'état par défaut est
 * écrit dans le HTML, chiffres compris. Le script ne fait que réécrire des
 * nœuds de texte existants — il ne construit rien. Sans lui, la page reste
 * lisible, indexable, et le pont vers le simulateur fonctionne.
 */
interface Props {
  title: string;
  cta: ContentLink;
  /** Ce que le pont promet, à gauche du bouton. */
  bridgeLabel: string;
  image?: ImageMetadata;
  imageAlt?: string;
  placeholder?: string;
}

const { title, cta, bridgeLabel, image, imageAlt = '', placeholder } = Astro.props;

/* Calculé au build : ce sont ces valeurs-là qui partent dans le HTML. */
const initial = estimate(POWER_DEFAULT);
const low = estimate(POWER_MIN);
const high = estimate(POWER_MAX);

/* Deux positions, deux vitesses (voir l'en-tête de `powerWidget.ts`) :
   la piste suit le pouce sans inertie, la jauge de prix est poursuivie. */
const initialPowerRatio = powerRatio(POWER_DEFAULT);
const initialPriceRatio = gaugeRatio(initial.price, low.price, high.price);
---

<section class="power">
  {image ? (
    <Image
      src={image}
      alt={imageAlt}
      {/* ⚠️ `width`, `widths`, `sizes` et `quality` doivent rester IDENTIQUES à
          ceux de `PageHero.astro`. Cette bande reprend la photo du hero : à
          réglages égaux, `astro:assets` produit le même fichier et le navigateur
          ne télécharge qu'une fois. Une seule valeur qui diverge et il génère un
          second jeu de variantes complet — des centaines de Ko pour une image
          déjà en cache, sans aucun signal. */}
      width={1440}
      widths={[640, 768, 1024, 1280, 1440]}
      sizes="100vw"
      format="webp"
      quality={72}
      loading="lazy"
      class="power__image"
    />
  ) : (
    <div class="power__image power__image--placeholder" role="img" aria-label={`Photo à fournir : ${placeholder}`}></div>
  )}
  <div class="power__overlay" aria-hidden="true"></div>

  <div class="power__panel reveal">
    <div class="power__head">
      <h2 class="power__title">{title}</h2>
      {/* `aria-hidden` : la valeur est déjà annoncée par le curseur lui-même,
          dont c'est le rôle. L'afficher deux fois la ferait lire deux fois. */}
      <p class="power__value" data-power-display aria-hidden="true">{formatPower(POWER_DEFAULT)}</p>
    </div>

    <div class="power__card">
      <label class="visually-hidden" for="power-range">
        Puissance installée, en kilowatts-crête
      </label>
      <input
        class="power__range"
        id="power-range"
        type="range"
        min={POWER_MIN}
        max={POWER_MAX}
        step={POWER_STEP}
        value={POWER_DEFAULT}
        data-power-input
        aria-valuetext={formatPower(POWER_DEFAULT)}
        style={`--power-ratio: ${initialPowerRatio}%`}
      />

      {/* ⚠️ PAS de région live ici, contrairement à une première version.
          Les chiffres traversent maintenant leurs valeurs intermédiaires : un
          lecteur d'écran en annoncerait des dizaines par glissé. L'annonce se
          fait une seule fois, à la fin du geste, dans `[data-power-status]`. */}
      <ul class="power__results">
        <li class="power__result power__result--accent">
          <span class="power__result-label">Prix estimé</span>
          <span class="power__result-value" data-power-price>{formatEuro(initial.price)}</span>
        </li>
        <li class="power__result">
          <span class="power__result-label">Panneaux</span>
          <span class="power__result-value" data-power-panels>{initial.panels}</span>
        </li>
        <li class="power__result">
          <span class="power__result-label">Production/an</span>
          {/* `&#8239;` (U+202F) partout, comme `THIN_NBSP` dans powerWidget.ts :
              une espace insécable ordinaire ici et fine au premier déplacement
              décalerait la valeur sous les yeux. */}
          <span class="power__result-value" data-power-production>{formatNumber(initial.production)}&#8239;kWh</span>
        </li>
      </ul>

      {/* Jauge de prix, distincte du curseur : elle situe le montant courant
          dans la fourchette annoncée par ses deux bornes, qui sont écrites
          juste dessous. Purement descriptive, donc retirée de l'oral — les
          deux bornes, elles, restent lues. */}
      <div class="power__gauge" data-power-gauge style={`--price-ratio: ${initialPriceRatio}%`} aria-hidden="true"></div>
      <p class="power__bounds">
        <span>{POWER_MIN}&#8239;kWc · ~{formatEuro(low.price)}</span>
        <span>{POWER_MAX}&#8239;kWc · ~{formatEuro(high.price)}</span>
      </p>

      {/* L'annonce sonore du module, posée une fois le geste terminé. Vide au
          chargement : les valeurs par défaut sont déjà lisibles à l'écran, les
          répéter à l'arrivée sur la page n'apprendrait rien. */}
      <p class="visually-hidden" data-power-status role="status" aria-live="polite"></p>

      <div class="power__bridge">
        <p class="power__bridge-label">{bridgeLabel}</p>
        <Button href={cta.href}>{cta.label}</Button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initPowerWidget } from '../scripts/powerWidget';
  initPowerWidget(document);
</script>

<style>
  .power {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--section-padding-block) var(--container-padding);
    overflow: hidden;
  }

  .power__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }

  .power__image--placeholder {
    background: var(--color-shade-grey);
  }

  .power__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--overlay-photo);
  }

  .power__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--width-power-panel);
    padding: var(--pad-power-panel);
    border-radius: var(--radius-panel);
    background: var(--bg-glass-fill-menu);
    backdrop-filter: blur(var(--bg-glass-blur-menu));
    border: var(--bg-glass-border);
  }

  .power__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .power__title {
    /* Le H2 pleine taille (48px) déséquilibrait le panneau : ce titre n'ouvre
       pas une section, il nomme un réglage. */
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line-height);
  }

  .power__value {
    font-family: var(--text-display-mid-family);
    font-size: var(--text-h3-size);
    font-weight: var(--text-display-mid-weight);
    line-height: 1;
    letter-spacing: var(--text-display-mid-tracking);
    /* ⚠️ PAS de `tabular-nums` ici, contrairement aux tuiles de résultat.
       Depuis que la puissance peut porter une décimale, la chasse tabulaire
       donne à la VIRGULE la largeur d'un chiffre : « 6,4 kWc » se lit « 6 , 4 »
       et gagne 12px pour rien. Cette valeur est calée à droite dans un
       `space-between` — elle grandit donc vers la gauche, sans jamais faire
       bouger le titre (vérifié à 320px). Elle n'a pas besoin d'être tabulaire. */
  }

  .power__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding: var(--pad-card-lg-block);
    border-radius: var(--radius-panel);
    background: var(--color-white-primary);
  }

  /* --- Curseur ---
     Apparence remise à zéro puis reconstruite : la piste porte sa portion
     parcourue en dégradé dur, pilotée par `--power-ratio` que le script met à
     jour. Une seule custom property change par déplacement — pas de mesure,
     pas de lecture de mise en page. */
  .power__range {
    appearance: none;
    width: 100%;
    height: var(--size-power-knob);
    margin: 0;
    background: transparent;
    cursor: pointer;
  }

  .power__range::-webkit-slider-runnable-track {
    height: var(--height-power-track);
    border-radius: var(--radius-pill);
    background: linear-gradient(
      to right,
      var(--color-ink-700) var(--power-ratio),
      var(--color-shade-grey) var(--power-ratio)
    );
  }

  .power__range::-moz-range-track {
    height: var(--height-power-track);
    border-radius: var(--radius-pill);
    background: var(--color-shade-grey);
  }

  .power__range::-moz-range-progress {
    height: var(--height-power-track);
    border-radius: var(--radius-pill);
    background: var(--color-ink-700);
  }

  .power__range::-webkit-slider-thumb {
    appearance: none;
    width: var(--size-power-knob);
    height: var(--size-power-knob);
    border-radius: var(--radius-pill);
    background: var(--color-white-primary);
    border: var(--border-width) solid var(--color-shade-strong);
    /* Recentre la poignée sur une piste plus fine qu'elle. */
    margin-top: calc((var(--height-power-track) - var(--size-power-knob)) / 2);
  }

  .power__range::-moz-range-thumb {
    width: var(--size-power-knob);
    height: var(--size-power-knob);
    border-radius: var(--radius-pill);
    background: var(--color-white-primary);
    border: var(--border-width) solid var(--color-shade-strong);
  }

  .power__range:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-ink-900);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-pill);
  }

  /* --- Résultats --- */
  .power__results {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    padding: var(--space-2);
    margin: 0;
    list-style: none;
    border-radius: var(--radius-card);
    background: var(--color-white-clear);
  }

  .power__result {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-2);
    border-radius: var(--radius-card);
    text-align: center;
    /* Même piège que les cartes de « L'essentiel » : sans `min-width: 0`, la
       valeur en `nowrap` impose sa largeur à la colonne et les trois tuiles
       débordent du panneau. */
    min-width: 0;
  }

  /* Le prix est ce que la page promet de montrer : c'est lui qui porte
     l'aplat d'accent, pas la production. */
  .power__result--accent {
    background: var(--color-highlight-primary);
  }

  .power__result-label {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    font-weight: var(--text-body-sm-weight);
    line-height: var(--text-body-sm-line-height);
  }

  .power__result--accent .power__result-label {
    color: var(--color-text-secondary);
  }

  .power__result-value {
    font-family: var(--text-display-mid-family);
    font-size: var(--text-power-value-size);
    font-weight: var(--text-display-mid-weight);
    line-height: 1;
    letter-spacing: var(--text-display-mid-tracking);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* --- Jauge de prix ---
     Pilotée par `--price-ratio`, que la boucle de poursuite met à jour image par
     image — et non par `--power-ratio`, qui suit le pouce sans inertie. C'est
     cette séparation qui permet au remplissage de la piste de coller au doigt
     pendant que la jauge, elle, glisse. */
  .power__gauge {
    width: 100%;
    height: var(--height-power-gauge);
    border-radius: var(--radius-pill);
    background: linear-gradient(
      to right,
      var(--color-ink-700) var(--price-ratio),
      var(--color-shade-grey) var(--price-ratio)
    );
  }

  /* Les bornes légendent la jauge : elles doivent la toucher, pas flotter à
     l'écart de la pile. La marge négative annule l'écart de la carte et repose
     le sien — dérivée de `--space-24`, elle suit donc toute retouche de cet
     écart au lieu de se décrocher. */
  .power__bounds {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: calc(var(--space-24) * -1 + var(--space-2));
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line-height);
  }

  /* --- Pont vers le simulateur ---
     Sur mobile, le libellé se centre au-dessus d'un bouton pleine largeur
     (Figma 466:1831) : côte à côte, il ne resterait ni assez de place au texte
     ni assez de surface tactile au bouton. */
  .power__bridge {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    text-align: center;
  }

  /* Le bouton est en `inline-flex` : sans cette règle il garderait la largeur
     de son libellé au lieu de remplir la colonne. */
  .power__bridge :global(.btn) {
    justify-content: center;
  }

  .power__bridge-label {
    font-family: var(--text-h4-family);
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
    line-height: var(--text-h4-line-height);
    letter-spacing: var(--text-h4-tracking);
  }

  @media (min-width: 768px) {
    .power {
      min-height: var(--height-power-band);
    }

    .power__title {
      font-size: 36px;
      line-height: 0.96;
    }

    .power__value {
      font-size: var(--text-display-mid-size);
    }

    .power__bridge {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: start;
    }
  }

  /* ⚠️ Les trois tuiles restent de front à TOUTES les tailles (Figma 466:1831).
     Elles ne s'empilent pas : la valeur du module est de montrer trois grandeurs
     qui bougent ensemble, et une pile les ferait défiler l'une après l'autre.
     C'est la typographie qui absorbe la contrainte — voir
     `--text-power-value-size`. Le padding latéral tombe à 4px : sur un écran de
     320px, chaque tuile ne dispose que d'une centaine de pixels. */
  /* Le panneau et sa carte perdent leurs 25px de padding au profit de 12
     (relevé sur la maquette mobile) : imbriqués, ils retiraient 100px de
     largeur à un écran de 320 avant même d'arriver aux tuiles. */
  @media (max-width: 767px) {
    .power {
      padding-inline: var(--container-padding);
    }

    .power__panel,
    .power__card {
      padding: var(--space-12);
    }

    .power__result {
      padding: var(--space-3) var(--space-1);
      gap: var(--space-1);
    }

    .power__result-label {
      font-size: var(--text-utility-mobile-size);
    }
  }

  /* Règle compagnon, isolée et en fin de bloc — voir design.md §3. */
  .power__panel {
    -webkit-backdrop-filter: blur(var(--bg-glass-blur-menu));
  }
</style>
