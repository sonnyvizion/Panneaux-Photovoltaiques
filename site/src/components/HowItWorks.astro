---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import maisonImage from '../assets/steps/maison_home.webp';
import expertImage from '../assets/steps/expert_home.webp';

/** Valeurs relevées au dev mode Figma (nœud 356:431). */
const steps = [
  {
    title: 'Je renseigne ma maison',
    detail: 'Code postal · consommation · orientation du toit en 2 minutes',
    image: maisonImage,
    alt: 'Maquette 3D d’un quartier résidentiel, une maison repérée par une épingle',
    tone: 'photo',
  },
  {
    title: 'Je reçois mon estimation personnalisée',
    detail: "Fourchette d'économies · budget estimé · aides de ma région · ROI",
    tone: 'light',
  },
  {
    title: 'Un expert analyse mon toit, gratuitement',
    detail: 'Rendez-vous direct avec l’installateur · chiffrage précis · sans engagement',
    image: expertImage,
    alt: 'Expert en casque de chantier observant une toiture, tablette à la main',
    tone: 'photo',
  },
] as const;
---

<Section tone="grey">
  <SectionHeading
    overline="Le processus"
    overlineTone="tertiary"
    {/* Espace insécable en échappée `\u00A0`, et NON `&nbsp;` : une entité
        n'est décodée que dans du balisage. Dans une valeur de prop elle reste
        du texte, puis son `&` est échappé — le lecteur voyait « marche&nbsp;? ».
        Les entités des autres composants sont dans du balisage et fonctionnent
        très bien : c'est le passage par une prop qui fait la différence.

        Échappée plutôt que le caractère lui-même : un U+00A0 posé en clair est
        invisible à la relecture, et le premier éditeur qui normalise les
        espaces le remplace sans que personne s'en aperçoive. */}
    title={`Comment ça marche\u00A0?`}
    intro="Trois étapes, sans engagement, du code postal jusqu'à la visite d'un installateur."
  />

  <ol class="steps reveal">
    {steps.map((step, index) => (
      <li class="steps__slide">
        <article class={`steps__item steps__item--${step.tone}`}>
          {step.image && (
            <>
              <Image
                src={step.image}
                alt={step.alt}
                widths={[400, 800, 1448]}
                sizes="(min-width: 768px) 33vw, 100vw"
                quality={75}
                loading="lazy"
                class="steps__media"
              />
              <div class="steps__veil" aria-hidden="true"></div>
            </>
          )}
          <div class="steps__body">
            <p class="steps__number" aria-hidden="true">{index + 1}</p>
            <h3 class="steps__title">{step.title}</h3>
            <p class="steps__detail">{step.detail}</p>
          </div>
        </article>
      </li>
    ))}
  </ol>

  <div class="steps__cta">
    <Button variant="ink" href="/simulateur">Commencer mon estimation</Button>
  </div>
</Section>

<style>
  .steps {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(260px, 84vw);
    gap: var(--space-2);
    list-style: none;
    width: 100vw;
    margin-block: 0;
    margin-inline: calc((100vw - 100%) / -2);
    padding-inline: var(--container-padding);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--container-padding);
    scrollbar-width: none;
  }

  .steps::-webkit-scrollbar {
    display: none;
  }

  .steps__slide {
    display: flex;
    justify-content: center;
    min-width: 0;
    scroll-snap-align: center;
  }

  .steps__item {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-3);
    padding: var(--pad-step-block) var(--space-24);
    min-height: var(--height-step);
    width: min(100%, max(260px, 84%));
  }

  .steps__item--light {
    background: var(--color-white-clear);
    color: var(--color-ink-900);
  }

  .steps__media,
  .steps__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .steps__media {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dégradé bas : décolle le texte de la photo sans ombre portée. */
  .steps__veil {
    background: var(--overlay-step);
  }

  .steps__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    text-align: center;
  }

  .steps__item--photo .steps__body {
    color: var(--color-text-inverted);
  }

  .steps__number {
    margin: 0 0 auto;
    font-family: var(--text-display-mid-family);
    font-size: var(--text-step-number);
    font-weight: var(--text-display-mid-weight);
    line-height: var(--text-display-mid-line-height);
    letter-spacing: var(--text-display-mid-tracking);
  }

  .steps__title {
    margin: 0;
    font-family: var(--text-h4-family);
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
    line-height: var(--text-h4-line-height);
    letter-spacing: var(--text-h4-tracking);
  }

  .steps__detail {
    margin: 0;
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-sm-size);
    font-weight: var(--text-body-light-weight);
    line-height: var(--text-body-sm-line-height);
    letter-spacing: var(--text-body-light-tracking);
  }

  .steps__cta {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-flow: row;
      grid-auto-columns: auto;
      gap: var(--space-12) var(--gap-step);
      max-width: var(--width-steps);
      margin-inline: auto;
      margin-block: 0;
      width: 100%;
      padding-inline: 0;
      overflow: visible;
      scroll-snap-type: none;
      scroll-padding-inline: 0;
    }

    .steps__slide {
      padding-inline: 0;
    }

    .steps__item {
      width: 100%;
    }

    .steps__detail {
      font-size: var(--text-body-light-size);
      line-height: var(--text-body-light-line-height);
    }
  }
</style>
