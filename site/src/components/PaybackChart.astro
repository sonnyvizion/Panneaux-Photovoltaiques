---
import { formatEuro } from '../scripts/powerEstimate';
import { CHART_H, CHART_W, paybackGeometry, paybackLabel } from '../scripts/payback';
import {
  ELECTRICITY_PRICE,
  REGION_DEFAULT,
  SELF_CONSUMPTION_RATE,
  regionLabel,
  type Region,
} from '../scripts/savings';

/**
 * Timeline d'amortissement — brique du catalogue (`interactivite-seo.md`),
 * famille H « schéma tracé au scroll ». Un axe de 25 ans, la courbe des
 * économies cumulées, la ligne plate du coût initial, et le point où l'une
 * croise l'autre.
 *
 * ⚠️ MONTÉE DEUX FOIS, c'est le contrat du catalogue : « on construit chaque
 * brique une fois, on la réutilise dans le simulateur (pour calculer) ET dans le
 * contenu (pour expliquer) ». Sur `/rentabilite-prix/amortissement` elle
 * illustre le cas médian, calculé au build ; dans le simulateur elle trace le
 * projet du visiteur et se redessine à chaque mise à jour.
 *
 * ⚠️ Le composant portait « AUCUNE ENTRÉE UTILISATEUR, et c'est délibéré :
 * règle d'or #3, un seul simulateur ». Ce raisonnement vaut sur une page de
 * contenu — un module qui y calculerait ferait concurrence au simulateur. Il ne
 * vaut plus DANS le simulateur, qui est précisément ce seul simulateur. D'où le
 * drapeau `live` : la page reste muette, l'outil calcule.
 *
 * ⚠️ ZÉRO ARITHMÉTIQUE ICI : tout vient de `paybackGeometry()`, pure et testée.
 *
 * ⚠️ Le SVG est `aria-hidden` et purement illustratif : TOUT ce qu'il montre est
 * écrit en toutes lettres juste en dessous. C'est le texte qui porte
 * l'information (règle d'or #1), le dessin ne fait que la rendre évidente.
 */
interface Props {
  kwc: number;
  region?: Region;
  /**
   * Le graphe se redessine à l'exécution. Réservé au simulateur : il coupe
   * l'animation de tracé au défilement, qui rejouerait à chaque frappe.
   */
  live?: boolean;
  /** Le rappel des hypothèses, hors de propos quand le visiteur les a saisies. */
  hypotheses?: boolean;
  /**
   * Le coût de départ dans la lecture chiffrée. Coupé dans le simulateur, où il
   * a déjà sa tuile « Budget indicatif » à quelques pixels de là.
   */
  showCost?: boolean;
  /**
   * Le titre du graphe.
   *
   * ⚠️ Optionnel, et absent par défaut : sur `/rentabilite-prix/amortissement`
   * le `SectionHeading` de `PaybackTimeline` titre déjà le bloc, un second
   * intitulé ferait doublon. Dans le compte rendu du simulateur, le graphe
   * n'est précédé de rien — sans ce titre, il ne dit pas ce qu'il mesure.
   */
  caption?: string;
  /**
   * Le TRACÉ. `true` par défaut — la page de contenu ne vit que par lui.
   *
   * ⚠️ Le compte rendu du simulateur le coupe : la courbe y prenait un tiers de
   * la hauteur de l'écran pour dire ce que les deux tuiles disent en trois mots,
   * et le détail visuel est ce qui donne sa valeur au rapport PDF. La lecture
   * chiffrée, elle, reste : c'est elle qui porte l'information (règle d'or #1).
   */
  plot?: boolean;
}

const {
  kwc,
  region = REGION_DEFAULT,
  live = false,
  hypotheses = true,
  showCost = true,
  caption,
  plot = true,
} = Astro.props;
const g = paybackGeometry(kwc, { region });
const PAD = 8;

/**
 * Les graduations de l'axe vertical, en euros.
 *
 * ⚠️ Sans elles le graphe montrait une FORME, pas une quantité : on voyait une
 * courbe monter sans savoir vers quoi. Trois repères suffisent — un axe
 * finement gradué prétendrait à une précision que l'estimation n'a pas.
 *
 * La position se déduit de la même projection que le tracé (`payback.ts`) :
 * `PAD` en haut et en bas, le reste proportionnel. La recalculer autrement
 * décalerait les étiquettes par rapport à la courbe.
 */
const scale = [1, 0.5, 0].map((share) => ({
  value: g.maxY * share,
  top: ((CHART_H - PAD - share * (CHART_H - PAD * 2)) / CHART_H) * 100,
}));

/* Le croisement, en pourcentage du cadre — mêmes unités que l'échelle. */
const crossLeft = ((g.crossX ?? 0) / CHART_W) * 100;
const crossTop = (g.costY / CHART_H) * 100;
---

<div class={`payback__chart-block${live ? ' payback__chart-block--live' : ''}`} data-payback>
  {caption && <p class="payback__caption">{caption}</p>}

  {plot && (
    <div class="payback__chart">
      <div class="payback__plot">
        {/* L'échelle verticale. `aria-hidden` comme le tracé : la lecture chiffrée
            en dessous porte l'information, ceci ne fait que la situer. */}
        <ul class="payback__scale" aria-hidden="true" data-payback-scale>
          {scale.map(({ value, top }) => (
            <li style={`top:${top.toFixed(1)}%`}>{formatEuro(Math.round(value / 100) * 100)}</li>
          ))}
        </ul>

      {/* Décoratif : la lecture chiffrée est juste en dessous, en texte. */}
      <svg
        class="payback__svg"
        viewBox={`0 0 ${CHART_W} ${CHART_H}`}
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path class="payback__benefit" d={g.benefit} data-payback-benefit />
        <line class="payback__cost" x1={PAD} y1={g.costY} x2={CHART_W - PAD} y2={g.costY} data-payback-cost />
        <path class="payback__curve" d={g.curve} pathLength="1" data-payback-curve />
      </svg>

        {/* ⚠️ LE POINT DE CROISEMENT N'EST PAS DANS LE SVG. Il y était, en
            `<circle r="11">` — et `preserveAspectRatio="none"` l'écrasait en
            ellipse, puisque le tracé s'étire en largeur avec le panneau. C'est
            voulu pour une courbe de tendance (sa pente exacte n'a pas à être
            préservée), mais un disque, lui, doit rester un disque.

            Posé en HTML par-dessus, il garde sa forme à toutes les largeurs. Ses
            coordonnées restent celles du `viewBox`, exprimées en pourcentage :
            c'est la même projection, donc il tombe exactement sur la courbe. */}
        <span
          class="payback__cross"
          aria-hidden="true"
          hidden={g.crossX === null}
          style={`left:${crossLeft.toFixed(2)}%;top:${crossTop.toFixed(2)}%`}
          data-payback-cross
        ></span>
      </div>

      <p class="payback__axis" aria-hidden="true" data-payback-axis>
        {g.marks.map((year) => <span>{year === 1 ? 'Année 1' : `${year} ans`}</span>)}
      </p>

      {/* ⚠️ LA LÉGENDE MANQUAIT. Rien n'indiquait que la ligne en tirets est le
          coût de l'installation et la courbe les économies cumulées : sans ces
          deux mots, le dessin est décoratif — on voit deux traits monter et
          stagner sans savoir lequel dit quoi. */}
      <ul class="payback__legend">
        <li><span class="payback__key payback__key--curve" aria-hidden="true"></span>Économies cumulées</li>
        <li><span class="payback__key payback__key--cost" aria-hidden="true"></span>Coût de l’installation</li>
      </ul>
    </div>
  )}

  {/* La lecture du schéma, en toutes lettres. */}
  <dl class="payback__readout">
    {/* ⚠️ L'ACCENT NE SE POSE QUE SUR UNE BONNE NOUVELLE. Le lime est la couleur
        d'action du système ; l'appliquer à « au-delà de 25 ans » mettait en
        valeur le verdict le plus défavorable, et la tuile lisait comme un
        argument de vente. Quand l'installation ne s'amortit pas, la tuile
        redevient neutre. */}
    <div class={`payback__item${g.payback === null ? '' : ' payback__item--accent'}`} data-payback-tile>
      <dt>Amortissement</dt>
      <dd data-payback-years>{paybackLabel(g.payback)}</dd>
    </div>
    {showCost && (
      <div class="payback__item">
        <dt>Coût de départ</dt>
        <dd data-payback-cost-value>{formatEuro(g.cost)}</dd>
      </div>
    )}
    {/* ⚠️ « Bilan » et non « Gain ». En Wallonie, le tarif prosumer fait que
        l'installation ne se rembourse pas sur l'horizon : le chiffre est
        NÉGATIF, et la page publiait « Gain net à 25 ans : -2 000 € ». Le nombre
        est juste — c'est le modèle validé par le client — mais un montant
        négatif n'est pas un gain. « Bilan » dit la vérité dans les deux sens,
        sans rien forcer. */}
    <div class="payback__item">
      <dt>Bilan à 25 ans</dt>
      <dd data-payback-gain>{formatEuro(Math.round(g.gain / 100) * 100)}</dd>
    </div>
  </dl>

  {/* ⚠️ L'ÉTAT « JAMAIS AMORTI » DOIT SE DIRE. Le graphe montre alors une courbe
      qui ne croise rien : sans un mot, le visiteur voit un dessin qui monte et
      croit que tout va bien. On nomme l'écart, et on nomme le levier — l'affinage
      est le seul qui puisse retourner ce verdict (il fait passer l'autoconsommation
      de 38 % à 60-70 %). */}
  <p class="payback__shortfall" hidden={g.payback !== null} data-payback-shortfall>
    Sur 25 ans, les économies cumulées n’atteignent pas le coût de l’installation.
    Une puissance plus faible, ou un chauffage et une voiture qui consomment votre
    propre production, changent complètement ce calcul.
  </p>

  {hypotheses && (
    <p class="payback__hypotheses">
      Installation de {kwc} kWc en {regionLabel(region)} ·
      {' '}{Math.round(SELF_CONSUMPTION_RATE * 100)} % d’autoconsommation ·
      électricité à {ELECTRICITY_PRICE.toFixed(2).replace('.', ',')} €/kWh ·
      dégradation de 0,5 % par an
    </p>
  )}
</div>

<style>
  .payback__chart-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* ⚠️ Le tracé au défilement est COUPÉ quand le graphe est vivant : réécrire le
     `d` d'un chemin dont le `stroke-dasharray` est piloté par
     `animation-timeline: view()` rejoue l'animation à chaque mise à jour, et la
     courbe clignote. Sur la page de contenu, où rien ne bouge, elle reste. */
  .payback__chart-block--live .payback__curve,
  .payback__chart-block--live .payback__benefit,
  .payback__chart-block--live .payback__cross {
    animation: none;
  }

  .payback__caption {
    color: var(--color-text-primary);
    font-family: var(--text-h4-family);
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
    line-height: var(--text-h4-line-height);
  }

  .payback__chart {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* L'échelle est posée SUR le tracé, pas à côté : une colonne d'étiquettes en
     flux rétrécirait le graphe, et c'est la largeur qui rend la pente lisible. */
  .payback__plot {
    position: relative;
  }

  .payback__scale {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .payback__scale li {
    position: absolute;
    left: 0;
    transform: translateY(-50%);
    padding-inline: var(--space-1);
    border-radius: var(--radius-1);
    background: var(--color-white-primary);
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-utility-mobile-size);
    line-height: var(--text-body-sm-line-height);
  }

  .payback__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-utility-mobile-size);
    line-height: var(--text-body-sm-line-height);
  }

  .payback__legend li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Les clés reprennent EXACTEMENT le trait qu'elles nomment — même couleur,
     même tireté. Une pastille ronde obligerait à faire le lien de tête. */
  .payback__key {
    flex: none;
    width: var(--space-4);
    border-top-style: solid;
    border-top-width: 3px;
  }

  .payback__key--curve {
    border-top-color: var(--color-text-primary);
  }

  .payback__key--cost {
    border-top-style: dashed;
    border-top-width: 2px;
    border-top-color: var(--color-text-muted);
  }

  .payback__shortfall {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
    font-weight: var(--text-body-light-weight);
    line-height: var(--text-body-light-line-height);
  }

  /* `display: flex`/`block` bat la règle UA sur `[hidden]` — garde-fou obligatoire
     pour tout bloc masquable, le projet l'a déjà payé cinq fois. */
  .payback__shortfall[hidden] {
    display: none;
  }

  /* `preserveAspectRatio: none` : le tracé s'étire en largeur avec le panneau.
     C'est une courbe de tendance, pas un relevé — sa pente exacte n'a pas à être
     préservée, et l'étirement évite une hauteur fixe qui écraserait le mobile. */
  .payback__svg {
    /* ⚠️ `display: block` : en inline, le SVG laisse sous lui l'espace de la
       ligne de base, le cadre devient plus haut que le tracé, et TOUT ce qui se
       positionne en pourcentage par-dessus (l'échelle, le point de croisement)
       glisse vers le bas. */
    display: block;
    width: 100%;
    height: var(--height-payback);
    overflow: visible;
  }

  .payback__benefit {
    fill: var(--color-highlight-primary);
    opacity: 0.35;
  }

  /* La ligne du coût est en tirets : c'est un seuil, pas une trajectoire. */
  .payback__cost {
    stroke: var(--color-text-muted);
    stroke-width: 2;
    stroke-dasharray: 8 8;
  }

  .payback__curve {
    fill: none;
    stroke: var(--color-text-primary);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .payback__cross {
    position: absolute;
    width: var(--space-3);
    height: var(--space-3);
    /* Le disque est centré SUR le croisement, pas posé à côté. */
    transform: translate(-50%, -50%);
    border: var(--border-width) solid var(--color-text-primary);
    border-radius: var(--radius-pill);
    background: var(--color-highlight-primary);
    pointer-events: none;
  }

  .payback__cross[hidden] {
    display: none;
  }

  .payback__axis {
    display: flex;
    justify-content: space-between;
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-utility-mobile-size);
    line-height: var(--text-body-sm-line-height);
  }

  /* --- La lecture chiffrée --- */
  .payback__readout {
    display: grid;
    /* `auto-fit` et non `repeat(3, …)` : le simulateur retire le coût de départ,
       et deux tuiles doivent alors se partager la largeur, pas en laisser une
       vide. */
    grid-template-columns: repeat(auto-fit, minmax(var(--width-sim-metric), 1fr));
    gap: var(--gap-cards);
    margin: 0;
  }

  /* ⚠️ CHAQUE TUILE PORTE SA SURFACE. Un bandeau `white-clear` les tenait
     ensemble, ce qui marchait sur une carte blanche. Dans le compte rendu du
     simulateur — désormais posé sur un fond `white-clear` — le bandeau
     disparaissait dans la page et les tuiles flottaient sans contour. Le filet
     fait le travail, et c'est le seul moyen de profondeur du système : il n'y a
     aucune ombre ici. */
  .payback__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-24) var(--space-3);
    border: var(--border-width) solid var(--color-shade-grey);
    border-radius: var(--radius-card);
    background: var(--color-white-primary);
    text-align: center;
  }

  .payback__item--accent {
    border-color: var(--color-highlight-primary);
    background: var(--color-highlight-primary);
  }

  .payback__item dt {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    font-weight: var(--text-body-sm-weight);
    line-height: var(--text-body-sm-line-height);
  }

  .payback__item--accent dt {
    color: var(--color-text-secondary);
  }

  .payback__item dd {
    margin: 0;
    font-family: var(--text-display-mid-family);
    font-size: var(--text-power-value-size);
    font-weight: var(--text-display-mid-weight);
    line-height: 1;
    letter-spacing: var(--text-display-mid-tracking);
    /* ⚠️ PAS de `tabular-nums`. Il était là du temps où ce bloc n'affichait qu'un
       nombre isolé (« 12 ans »). Depuis que le simulateur y écrit une fourchette,
       la chasse tabulaire élargit AUSSI l'espace et le tiret : « 4 – 8 ans » s'y
       délite en trois blocs. Piège déjà payé quatre fois dans ce projet.

       ⚠️ ET PLUS DE `white-space: nowrap` NON PLUS. Il protégeait la fourchette,
       mais faisait sortir « au-delà de 25 ans » (330px en display 44) d'une tuile
       de 192px sur la page Amortissement, où elles sont trois de front. Ce sont
       maintenant des espaces INSÉCABLES qui tiennent la fourchette — le repli
       reste possible pour la phrase, impossible pour le chiffre. */
    text-wrap: balance;
  }

  .payback__hypotheses {
    color: var(--color-text-muted);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-utility-mobile-size);
    line-height: var(--text-body-sm-line-height);
  }




  @media (max-width: 767px) {
    .payback__item {
      padding: var(--space-3) var(--space-1);
    }

    .payback__item dt {
      font-size: var(--text-utility-mobile-size);
    }
  }

  /* --- Le tracé au défilement ---
     `pathLength="1"` normalise la longueur du chemin : le `dasharray` s'écrit
     alors en fraction, sans avoir à mesurer la courbe. Même mécanisme que
     `PhotonFlow` — entièrement dans un `@supports` et un `prefers-reduced-motion`,
     donc la courbe est complète partout ailleurs. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .payback__curve {
        animation-name: payback-draw;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }

      /* L'aire et le point de croisement n'apparaissent qu'une fois la courbe
         tracée : le bénéfice est une conséquence, il ne doit pas précéder. */
      .payback__benefit,
      .payback__cross {
        animation-name: payback-appear;
        animation-duration: auto;
        animation-timing-function: ease-out;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 40% cover 55%;
      }

      @keyframes payback-draw {
        from {
          stroke-dasharray: 0 1;
        }
        to {
          stroke-dasharray: 1 0;
        }
      }

      @keyframes payback-appear {
        from {
          opacity: 0;
        }
      }
    }
  }
</style>
