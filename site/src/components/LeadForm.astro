---
import Button from './Button.astro';
import Badge from './Badge.astro';
import { PHONE } from '../data/site';

/**
 * Les formulaires de sortie du simulateur — écrans E, F et G du brief.
 *
 * ⚠️ ENVOI NON CÂBLÉ, volontairement. Trois blocages tiennent : le site est
 * statique (aucun endpoint), `/confidentialite` est encore un lien mort alors
 * que ces formulaires promettent une politique de données, et `PHONE` est un
 * placeholder. Le `action`/`method` se branchera d'un seul endroit, ici.
 *
 * ⚠️ Un seul composant pour les trois sorties : elles ne diffèrent que par les
 * champs demandés et l'engagement pris. Trois fichiers auraient triplé le style,
 * la mention légale et l'écran Q — et les auraient laissés diverger.
 *
 * ⚠️ Le rapport (G) ne demande QUE l'e-mail : c'est la sortie la moins
 * engageante du brief, celle qui reste ouverte à tous les profils.
 */
interface Props {
  variant: 'devis' | 'etude' | 'rapport';
  submitLabel: string;
}

const { variant, submitLabel } = Astro.props;
const asksContact = variant !== 'rapport';
const asksStatut = variant !== 'rapport';
---

<form class="lead" data-lead-form novalidate>
  <ul class="lead__badges">
    <li><Badge variant="lime" dot>Gratuit</Badge></li>
    <li><Badge variant="lime" dot>Sans engagement</Badge></li>
    <li><Badge variant="lime" dot>Aucune revente de données</Badge></li>
  </ul>

  {asksContact && (
    <div class="lead__row">
      <div class="lead__field">
        <label class="lead__label" for="lead-prenom">Prénom</label>
        <input class="lead__input" id="lead-prenom" name="prenom" autocomplete="given-name" required />
      </div>
      <div class="lead__field">
        <label class="lead__label" for="lead-nom">Nom</label>
        <input class="lead__input" id="lead-nom" name="nom" autocomplete="family-name" required />
      </div>
    </div>
  )}

  <div class="lead__field">
    <label class="lead__label" for="lead-email">Adresse e-mail</label>
    <input class="lead__input" id="lead-email" name="email" type="email" autocomplete="email" required />
  </div>

  {asksContact && (
    <div class="lead__row">
      <div class="lead__field">
        <label class="lead__label" for="lead-tel">Téléphone</label>
        <input class="lead__input" id="lead-tel" name="telephone" type="tel" autocomplete="tel" required />
      </div>
      <div class="lead__field">
        <label class="lead__label" for="lead-creneau">Quand vous joindre ?</label>
        <select class="lead__input" id="lead-creneau" name="creneau">
          <option value="matin">En matinée</option>
          <option value="apres-midi">L’après-midi</option>
          <option value="soir">En début de soirée</option>
          <option value="peu-importe">Peu importe</option>
        </select>
      </div>
    </div>
  )}

  {variant === 'devis' && (
    <div class="lead__field">
      <label class="lead__label" for="lead-adresse">Adresse de l’installation</label>
      <input class="lead__input" id="lead-adresse" name="adresse" autocomplete="street-address" required />
      <p class="lead__hint">Elle nous sert à vérifier la toiture sur vue aérienne avant de vous répondre.</p>
    </div>
  )}

  {variant === 'etude' && (
    <fieldset class="lead__field">
      <legend class="lead__label">Type de rendez-vous</legend>
      <div class="lead__choices">
        <label class="lead__choice"><input type="radio" name="rdv" value="domicile" checked /><span>À domicile</span></label>
        <label class="lead__choice"><input type="radio" name="rdv" value="visio" /><span>En visio</span></label>
        <label class="lead__choice"><input type="radio" name="rdv" value="telephone" /><span>Par téléphone</span></label>
      </div>
    </fieldset>
  )}

  {asksStatut && (
    <fieldset class="lead__field">
      <legend class="lead__label">Vous êtes</legend>
      <div class="lead__choices">
        <label class="lead__choice"><input type="radio" name="statut" value="proprietaire" checked /><span>Propriétaire</span></label>
        <label class="lead__choice"><input type="radio" name="statut" value="copropriete" /><span>En copropriété</span></label>
        <label class="lead__choice"><input type="radio" name="statut" value="locataire" /><span>Locataire</span></label>
      </div>

      {/* Écran Q — rendus au build, révélés par `leadForm.ts`. */}
      <p class="lead__notice" data-lead-notice="copropriete" hidden>
        En copropriété, la décision passe par l’assemblée générale. L’étude gratuite
        vous donne un dossier chiffré à présenter — arrivez à la réunion avec des
        chiffres, pas une intention.
      </p>
      <p class="lead__notice" data-lead-notice="locataire" hidden>
        En tant que locataire, vous ne pouvez pas engager les travaux : ce serait
        malhonnête de vous fixer un rendez-vous. Recevez plutôt
        <a href="/rapport">le rapport par e-mail</a> — c’est l’argument à présenter
        à votre propriétaire, et nous répondrons volontiers à ses questions.
      </p>
    </fieldset>
  )}

  {variant === 'etude' && (
    <div class="lead__block">
      <p class="lead__block-title">Pour préparer le rendez-vous</p>

      <fieldset class="lead__field">
        <legend class="lead__label">Ce que vous cherchez d’abord</legend>
        <div class="lead__choices">
          <label class="lead__choice"><input type="radio" name="objectif" value="facture" checked /><span>Baisser ma facture</span></label>
          <label class="lead__choice"><input type="radio" name="objectif" value="independance" /><span>Être indépendant</span></label>
          <label class="lead__choice"><input type="radio" name="objectif" value="environnement" /><span>Réduire mon empreinte</span></label>
        </div>
      </fieldset>

      <div class="lead__row">
        <div class="lead__field">
          <label class="lead__label" for="lead-horizon">Votre horizon</label>
          <select class="lead__input" id="lead-horizon" name="horizon">
            <option value="3-mois">Dans les 3 mois</option>
            <option value="6-mois">Dans les 6 mois</option>
            <option value="an">Cette année</option>
            <option value="renseigne">Je me renseigne</option>
          </select>
        </div>
        <div class="lead__field">
          <label class="lead__label" for="lead-budget">Budget envisagé</label>
          <select class="lead__input" id="lead-budget" name="budget">
            <option value="inconnu">Je ne sais pas encore</option>
            <option value="comptant">Paiement comptant</option>
            <option value="credit">Avec un financement</option>
          </select>
        </div>
      </div>
    </div>
  )}

  <div data-lead-submit>
    <Button type="submit">{submitLabel}</Button>
  </div>

  <p class="lead__legal">
    Vos données servent uniquement à vous répondre. Elles ne sont ni revendues ni
    transmises à un intermédiaire — <a href="/confidentialite">notre politique de confidentialité</a>.
  </p>

  <p class="lead__direct">
    Vous préférez parler tout de suite ? <a href={PHONE.href}>{PHONE.label}</a>.
  </p>
</form>

<script>
  import { initLeadForm } from '../scripts/leadForm';
  initLeadForm(document);
</script>

<style>
  .lead {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--width-timeline);
    margin-inline: auto;
    padding: var(--pad-card-lg-block);
    border-radius: var(--radius-panel);
    background: var(--color-white-primary);
  }

  .lead__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lead__row {
    display: grid;
    gap: var(--space-3);
  }

  .lead__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-inline-size: 0;
    padding: 0;
    margin: 0;
    border: 0;
  }

  .lead__label {
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    font-weight: var(--text-body-sm-weight);
  }

  .lead__input {
    width: 100%;
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-shade-grey);
    border-radius: var(--radius-card);
    background: var(--color-white-primary);
    color: var(--color-text-primary);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
  }

  .lead__input:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-main-green);
    outline-offset: var(--focus-ring-offset);
  }

  .lead__choices {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ⚠️ `min-width: min-content` et non `0` : à `0`, trois choix se partagent la
     largeur à parts égales et un libellé long est rogné (« Être indépendan… »).
     Ici la tuile ne descend jamais sous son mot le plus long — si la rangée ne
     tient plus, elle passe à la ligne au lieu de tronquer. */
  .lead__choice {
    flex: 1 1 auto;
    min-width: min-content;
    display: flex;
    /* Ancre l'input masqué en `position: absolute` : sans elle il se placerait
       dans le bloc conteneur du document et le ferait déborder. Le simulateur a
       payé ce piège au prix fort — voir `SimulatorPanels`. */
    position: relative;
  }

  .lead__choice input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .lead__choice span {
    flex: 1;
    padding: var(--space-3) var(--space-2);
    border: var(--border-width) solid var(--color-shade-grey);
    border-radius: var(--radius-card);
    background: var(--color-white-primary);
    cursor: pointer;
    text-align: center;
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
  }

  .lead__choice input:checked + span {
    background: var(--color-highlight-primary);
    border-color: var(--color-ink-900);
  }

  .lead__choice input:focus-visible + span {
    outline: var(--focus-ring-width) solid var(--color-ink-900);
    outline-offset: var(--focus-ring-offset);
  }

  .lead__notice {
    padding: var(--space-3);
    border-radius: var(--radius-card);
    background: var(--color-white-clear);
    color: var(--color-text-secondary);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
    line-height: var(--text-body-light-line-height);
  }

  .lead__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--pad-card);
    border-radius: var(--radius-card);
    background: var(--color-white-clear);
  }

  .lead__block-title {
    font-family: var(--text-h4-family);
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
  }

  .lead__hint,
  .lead__legal,
  .lead__direct {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-utility-mobile-size);
    line-height: var(--text-body-sm-line-height);
  }

  .lead :global(.btn) {
    justify-content: center;
    width: 100%;
  }

  @media (min-width: 640px) {
    .lead__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 767px) {
    .lead {
      padding: var(--space-12);
    }
  }
</style>
