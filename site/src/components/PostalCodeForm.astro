---
import Button from './Button.astro';

/**
 * Amorce du simulateur : un seul champ, aucun calcul ici.
 * Le bouton ouvre /simulateur avec le code postal (règle d'or #3).
 * Gabarit relevé au dev mode Figma (nœud 356:360).
 */
---

{/* L'`id="hero-cta"` a été retiré : le header ne l'observait que pour révéler
    son propre CTA, et il le fait désormais sur la sortie du hero entier — ce
    repère sortait de l'écran trop tôt, alors que le header était encore hors
    champ. Plus rien ne s'y accroche. */}
<form class="postal-form" action="/simulateur" method="get">
  <label class="visually-hidden" for="cp">Votre code postal</label>
  <input
    id="cp"
    type="text"
    name="cp"
    inputmode="numeric"
    autocomplete="postal-code"
    placeholder="Entrez votre code postal"
    class="postal-form__input"
    required
  />
  <Button type="submit">Estimer mon potentiel solaire</Button>
</form>

<style>
  /* Pas d'ombre portée : le champ se détache par contraste sur la photo. */
  .postal-form {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-form);
    width: 100%;
    max-width: var(--width-cta-simu);
    height: var(--height-cta-simu);
    padding: var(--pad-form-block) var(--pad-form-end) var(--pad-form-block)
      var(--pad-form-start);
    border-radius: var(--radius-pill);
    background: var(--bg-glass-fill-form);
    /* Le filet clair est ce qui signe l'effet verre : sans lui, un fond
       translucide passe pour un aplat. Recette design.md §3. */
    border: none;
    backdrop-filter: blur(var(--bg-glass-blur-form));
    transition: border-color var(--duration-fast) var(--easing-default);
  }

  /* Repère de focus discret : le filet de verre passe au blanc plein au lieu
     de l'anneau vert, jugé trop visible pendant la saisie. Il en faut un —
     l'`input` a son propre `outline: none`, sans quoi rien ne signalerait où
     l'on écrit au clavier. */
  .postal-form:focus-within {
    border-color: var(--color-white-primary);
  }

  .postal-form__input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    padding: 0;
    outline: none;
    color: var(--color-text-primary);
    font-family: var(--text-display-little-family);
    font-size: var(--text-body-nav-size);
    font-weight: var(--font-weight-book);
    letter-spacing: var(--text-body-nav-tracking);
  }

  .postal-form__input::placeholder {
    color: var(--color-input-placeholder);
  }

  @media (max-width: 479px) {
    .postal-form {
      flex-direction: column;
      align-items: stretch;
      height: auto;
      padding: 0;
      border-radius: 0;
      gap: var(--space-2);
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .postal-form__input {
      min-height: var(--height-cta-simu);
      padding-inline: var(--space-3);
      border-radius: var(--radius-pill);
      background: var(--bg-glass-fill-form);
      text-align: center;
    }

    .postal-form :global(.btn) {
      justify-content: space-between;
      width: 100%;
    }
  }

  /* Préfixe `-webkit-` isolé dans sa propre règle. Dans la même règle, le
     minifieur n'en garde qu'une des deux et le flou disparaissait de TOUT le
     site en production — pastilles, nav et carte du code postal. Il refuse par
     ailleurs de le générer lui-même, la valeur contenant un `var()` qu'il ne
     sait pas analyser. Safari antérieur à 18 en a encore besoin. */
  .postal-form {
    -webkit-backdrop-filter: blur(var(--bg-glass-blur-form));
  }

  .postal-form__input {
    -webkit-backdrop-filter: none;
  }
</style>
