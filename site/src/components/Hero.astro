---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero/hero.webp';
import PostalCodeForm from './PostalCodeForm.astro';
import Badge from './Badge.astro';

/** Gabarit relevé au dev mode Figma (nœud 356:354). */

/* Arguments repris du positionnement : pas d'intermédiaire, pas de revente de
   données, certification Enphase, couverture des trois régions. */
const reassurances = [
  'Sans engagement',
  'Gratuit',
  'Résultat en 2 min',
  'Sans intermédiaire',
  'Vos données ne sont pas revendues',
  'Installateur certifié Enphase',
  'Primes de votre région incluses',
  'Wallonie · Bruxelles · Flandre',
];
---

<section id="hero" class="hero">
  {/* Image LCP : `priority` la sort du lazy-loading et la précharge.
      `widths` + `sizes` pour le srcset ; `width` plafonne le fichier de repli,
      sinon Astro sert l'original 4608px (762 Ko) en `src`. Pas de `height` :
      le ratio d'origine est conservé, le cadrage est fait par object-fit. */}
  <Image
    src={heroImage}
    alt="Maison contemporaine à bardage sombre équipée de panneaux solaires en toiture, dans un environnement boisé"
    width={2560}
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    format="webp"
    {/* 85 et non 75 : c'est le LCP, la plus grande surface photographique de la
        page, et elle s'affiche à 0,91× de la densité Retina. Le détail
        photographique s'y voit — ailleurs, 75 suffit. */}
    quality={85}
    priority
    class="hero__image"
  />
  <div class="hero__overlay" aria-hidden="true"></div>

  {/* La nav vit dans BaseLayout et se pose ici en absolu : `#hero` reste son
      repère d'observation pour basculer entre transparent et détaché. */}

  {/* Seuls ces deux blocs sont dans le flux : ils se centrent dans les 788px.
      Barre utilitaire et pastilles sont hors flux, comme dans Figma. */}
  <div class="hero__text">
      {/* Pas de mot accentué : le dev mode ne colore aucun span du H1. */}
      <div class="hero__title-wrap">
        <h1 class="hero__title">
          Les panneaux solaires sont-ils rentables pour votre maison&nbsp;?
        </h1>
      </div>
    <p class="hero__subtitle">
      Production, coût, économies, primes de votre région&nbsp;:<br />
      votre estimation sur mesure, sans laisser vos coordonnées.
    </p>
  </div>

  <div class="hero__simu">
    <PostalCodeForm />
    {/* Seul « En savoir plus ? » est cliquable : le reste est une précision,
        pas une destination. Un lien qui n'englobe que sa cible est aussi plus
        clair à l'annonce vocale. */}
    <p class="hero__helper">
      Pour adapter le calcul à votre région et vos primes.<br />
      <a href="/simulateur">En savoir plus&nbsp;?</a>
    </p>
  </div>

  {/* Deux groupes identiques bout à bout : quand le premier a défilé de sa
      propre largeur, le second occupe exactement sa place — la boucle est
      invisible. Le second est un doublon décoratif, retiré aux lecteurs
      d'écran, qui n'entendent donc la liste qu'une fois. */}
  <div class="hero__reassurance">
    <ul class="marquee__group">
      {reassurances.map((mot) => (
        <li><Badge variant="glass" dot>{mot}</Badge></li>
      ))}
    </ul>
    <ul class="marquee__group" aria-hidden="true">
      {reassurances.map((mot) => (
        <li><Badge variant="glass" dot>{mot}</Badge></li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Carte détachée à toutes les tailles : retrait identique sur les quatre
     côtés, et rayon sur les quatre coins. Figma la dessine pleine largeur avec
     les coins bas seulement — écart assumé. */
  .hero {
    position: relative;
    margin: var(--hero-inset);
    min-height: var(--height-hero);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-hero);
    overflow: hidden;
    border-radius: var(--radius-panel);
    /* Réserve de quoi ne pas percuter la barre et les pastilles hors flux
       quand le contenu s'allonge sur petit écran. */
    padding-block: var(--space-96) var(--space-96);
  }

  .hero__image {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-image-focus);
  }

  /* Parallaxe du fond — CSS seul, sans écouteur de défilement.
     `animation-timeline: scroll()` est piloté par le compositeur : rien ne
     tourne sur le fil principal, l'INP n'est pas touché. Là où ce n'est pas
     supporté, `@supports` laisse simplement l'image fixe : aucune dégradation.
     Neutralisé si l'utilisateur demande moins de mouvement. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__image {
        top: calc(var(--hero-parallax-shift) * -1);
        height: calc(100% + var(--hero-parallax-shift) * 2);
        /* Propriétés détaillées, jamais le raccourci `animation` : le
           minifieur y replie `animation-timeline`, que Chrome n'accepte pas
           encore dans le raccourci — la déclaration devient invalide et la
           parallaxe ne part jamais. */
        animation-name: hero-parallax;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root block);
        animation-range: 0 var(--height-hero);
      }

      @keyframes hero-parallax {
        from {
          transform: translateY(calc(var(--hero-parallax-shift) * -1));
        }
        to {
          transform: translateY(var(--hero-parallax-shift));
        }
      }
    }
  }

  /* Cadrage constant à partir du desktop.
     En `object-fit: cover` seul, le recadrage suit le rapport du cadre : à 1920
     l'image s'affichait à 0,41× et on n'en voyait que 64 % en hauteur, à 1280
     elle tombait à 0,27× et se dévoilait presque entièrement — la maison y
     paraissait deux fois plus petite. Ici c'est la hauteur qui commande : la
     largeur suit le ratio de la source et déborde de chaque côté, donc
     l'échelle ne dépend plus de la largeur de l'écran. `max-width: none` lève
     le plafond global posé sur les images, sans quoi le débord est impossible.
     `min-width` reprend la main sur les écrans très larges, où la largeur
     redevient la contrainte. `translate` recentre le débord : il se compose
     avec le `transform` de la parallaxe au lieu de l'écraser.
     Le mobile garde le cadrage plein cadre : un tel débord latéral y couperait
     la maison. */
  @media (min-width: 768px) {
    .hero__image {
      left: 50%;
      right: auto;
      translate: -50% 0;
      width: auto;
      min-width: 100%;
      max-width: none;
      height: var(--hero-image-zoom);
    }

  }

  /* Figma : voile noir uni à 25 %, pas le dégradé coloré de design.md. */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--overlay-hero);
  }

  .hero__text,
  .hero__simu {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline: var(--container-padding);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__title-wrap {
    padding: var(--pad-h1);
  }

  .hero__title {
    max-width: var(--width-h1);
    width: 100%;
    margin: 0;
    color: var(--color-white-clear);
    font-family: var(--text-h1-family);
    font-size: var(--text-h1-size);
    font-weight: var(--text-h1-weight);
    line-height: var(--text-h1-line-height);
    letter-spacing: var(--text-h1-tracking);
  }

  .hero__subtitle {
    max-width: var(--width-hero-subtitle);
    width: 100%;
    margin: 0;
    /* Figma pose 95 % d'opacité sur un gris clair : le cumul des deux
       affaiblissait trop le sous-titre sur la photo. Plein blanc, sans voile. */
    color: var(--color-text-inverted);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
    font-weight: var(--text-body-light-weight);
    line-height: var(--text-body-light-line-height);
    letter-spacing: var(--text-body-light-tracking);
  }

  .hero__simu {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-hero-simu);
  }

  .hero__helper {
    max-width: var(--width-hero-helper);
    width: 100%;
    margin: 0;
    text-align: center;
    /* Le texte n'est plus dans le lien : il lui faut sa propre couleur, sinon
       il hériterait du noir du corps de page et disparaîtrait sur la photo. */
    color: var(--color-text-inverted);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
    font-weight: var(--text-body-light-weight);
    line-height: var(--text-body-light-line-height);
    letter-spacing: var(--text-body-light-tracking);
  }

  .hero__helper a {
    color: var(--color-text-inverted);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .hero__helper {
      font-size: var(--text-utility-size);
      line-height: var(--text-body-sm-line-height);
    }
  }

  @media (max-width: 479px) {
    .hero {
      justify-content: flex-start;
      gap: var(--space-3);
      padding-block: clamp(250px, 34svh, 320px)
        calc(var(--hero-pills-bottom) + var(--space-64));
    }

    .hero__title-wrap {
      padding-inline: 0;
    }

    .hero__title {
      font-size: var(--text-h1-mobile-compact-size);
      line-height: var(--text-h1-mobile-compact-line-height);
      letter-spacing: 0;
    }

    .hero__subtitle,
    .hero__helper {
      font-size: var(--text-body-sm-size);
      line-height: var(--text-body-sm-line-height);
    }

  }

  @media (max-width: 767px) {
    .hero {
      width: 100vw;
      margin: 0;
      min-height: 100svh;
      border-radius: 0 0 var(--radius-panel) var(--radius-panel);
      padding-top: clamp(250px, 34svh, 320px);
      padding-bottom: calc(var(--hero-pills-bottom) + var(--space-64));
    }

    .hero__image {
      object-position: 50% 42%;
    }

    .hero__text,
    .hero__simu {
      transform: none;
    }

    .hero__reassurance {
      bottom: var(--space-64);
    }
  }

  /* Hors flux : sinon elles rognent la hauteur dans laquelle le texte se centre.
     Fondu latéral par masque. Il impose de renoncer au `backdrop-filter` sur
     les pastilles : un masque crée un « backdrop root » et le flou n'aurait
     plus rien à flouter. Posé sur la pastille il ne l'atténuerait pas, et une
     opacité les ferait s'effacer sur place au lieu de défiler. Les deux effets
     sont exclusifs — arbitrage retenu : le fondu.
     `left`/`right` à 0 avec une largeur explicite et `margin-inline: auto`
     centrent la bande dans la carte. */
  .hero__reassurance {
    position: absolute;
    left: 0;
    right: 0;
    width: var(--width-marquee);
    margin-inline: auto;
    bottom: var(--hero-pills-bottom);
    z-index: 1;
    display: flex;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--marquee-fade),
      #000 calc(100% - var(--marquee-fade)),
      transparent
    );
  }

  .marquee__group {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    /* Le pas de séparation entre les deux groupes doit valoir celui qui sépare
       deux pastilles, sinon la boucle se voit au raccord. */
    padding: 0 var(--space-24) 0 0;
    margin: 0;
    list-style: none;
    /* Aucune compression : chaque groupe garde sa largeur réelle, condition
       pour que le décalage de 100 % retombe juste. */
    flex-shrink: 0;
    animation: marquee-scroll var(--duration-marquee) linear infinite;
  }

  @keyframes marquee-scroll {
    to {
      transform: translateX(-100%);
    }
  }

  /* Confort de lecture : le défilé s'arrête sous le curseur. */
  .hero__reassurance:hover .marquee__group {
    animation-play-state: paused;
  }

  /* Sans mouvement : on retombe sur la rangée centrée d'origine, le doublon
     n'ayant plus de raison d'être. */
  @media (prefers-reduced-motion: reduce) {
    .hero__reassurance {
      justify-content: center;
      padding-inline: var(--container-padding);
    }

    .marquee__group {
      flex-wrap: wrap;
      justify-content: center;
      flex-shrink: 1;
      padding: 0;
      animation: none;
    }

    .marquee__group[aria-hidden='true'] {
      display: none;
    }
  }


  /* Préfixe `-webkit-` isolé et placé en fin de bloc : dans la même règle, ou
     dans une règle adjacente au même sélecteur, le minifieur n'en garde qu'une
     des deux et le masque disparaîtrait du build de production. */
  .hero__reassurance {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--marquee-fade),
      #000 calc(100% - var(--marquee-fade)),
      transparent
    );
  }
</style>
