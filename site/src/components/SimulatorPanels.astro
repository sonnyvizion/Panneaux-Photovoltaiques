---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero/hero.webp';
import SimulatorWizard from './SimulatorWizard.astro';
import SimulatorStep from './SimulatorStep.astro';
import SimulatorResult from './SimulatorResult.astro';
import { ORIENTATIONS, TILTS } from '../scripts/orientation';
import { formatNumber } from '../scripts/format';
import {
  AREA_DEFAULT, AREA_MAX, AREA_MIN, AREA_STEP,
  BILL_BANDS, CONSUMPTION_DEFAULT, CONSUMPTION_MAX, CONSUMPTION_MIN, CONSUMPTION_STEP,
  PROPERTY_TYPES, ROOF_TYPES, SHADINGS, YES_NO_SOON,
} from '../scripts/simulator';
import { QUESTION_STEPS, REFINE_STEPS } from '../scripts/wizard';

/**
 * Le simulateur — les questions, le résultat, puis l'affinage.
 *
 * ⚠️ UNE QUESTION PAR ÉCRAN. Le rail (`SimulatorWizard`) porte la mécanique, ce
 * fichier ne fait qu'y ranger les questions dans l'ordre. Les cinq du brief,
 * plus une SIXIÈME conditionnelle : le code postal, posé uniquement à qui
 * arrive sans région connue. Le brief veut le code postal « mémorisé, jamais
 * redemandé » — ici il n'a jamais été donné, on ne le redemande donc pas.
 * Le PRIX DU kWh, lui, n'est pas une question : c'est `ELECTRICITY_PRICE`,
 * affiché dans les hypothèses du résultat.
 *
 * ⚠️ RIEN N'EST PRÉ-COCHÉ. Le visiteur choisit vraiment à chaque étape, sinon la
 * barre de progression mentirait et on récolterait des valeurs par défaut au
 * lieu de réponses. Conséquence assumée : le résultat rendu au build est un
 * exemple étiqueté — voir `SimulatorResult`.
 *
 * ⚠️ UN SEUL FORMULAIRE pour les deux parcours. L'affinage « reprend les
 * réponses déjà données » sans transfert ni stockage : elles n'ont jamais quitté
 * le formulaire.
 *
 * ⚠️ Le simulateur CALCULE, il ne QUALIFIE pas. Aucun champ e-mail, aucune
 * coordonnée ici : la qualification vit dans les formulaires de sortie.
 *
 * ⚠️ L'HABILLAGE EST CELUI DES MODULES, pas une coquille à part. Bande photo,
 * calque sombre, panneau de verre, carte blanche : la recette exacte de
 * `SliderCalculator`, qui habille déjà sept pages. Le simulateur est la colonne
 * vertébrale du site — il ne peut pas être le seul objet à parler une autre
 * langue que les modules qui y mènent.
 */

/* Le texte qui lève le doute, à côté de la question qui le fait naître. C'est la
   boucle « simulateur → contenu » posée par CLAUDE.md.
   ⚠️ `step` est le lien explicite avec l'identifiant d'étape : le script s'en
   sert pour n'afficher que le bloc de la question en cours. Sans ce champ, il
   faudrait deviner la correspondance depuis le nom de la clé. */
const HELP = {
  cp: {
    step: '0',
    body: 'Les aides, le tarif d’injection et le tarif prosumer ne se ressemblent pas d’une région à l’autre : le même toit ne donne pas du tout le même résultat à Bruxelles et en Wallonie.',
    href: '/aides-primes',
    label: 'Les aides par région',
  },
  property: {
    step: '1',
    body: 'Une copropriété peut tout à fait s’équiper, mais la décision passe par l’assemblée générale — et cela change le calendrier, pas la rentabilité.',
    href: '/aides-primes/copropriete',
    label: 'Le solaire en copropriété',
  },
  roof: {
    step: '2',
    body: 'Un toit plat n’empêche rien : les panneaux reposent sur des supports lestés qui leur donnent l’inclinaison voulue.',
    href: '/installation/toit-plat',
    label: 'Panneaux sur toit plat',
  },
  orientation: {
    step: '3',
    body: 'Le plein sud produit le plus, mais un toit est/ouest ne perd que 15 % — et étale sa production sur toute la journée, ce qui aide l’autoconsommation.',
    href: '/rentabilite-prix/rendement',
    label: 'L’effet de l’orientation',
  },
  area: {
    step: '4',
    body: 'Comptez environ 2 m² par panneau sur un toit incliné, davantage sur un toit plat où les rangées ne doivent pas s’ombrer entre elles.',
    href: '/installation/nombre-de-panneaux',
    label: 'Combien de panneaux ?',
  },
  consumption: {
    step: '5',
    body: 'Ce qui compte n’est pas ce que vous produisez, mais ce que vous consommez au moment où vous le produisez.',
    href: '/rentabilite-prix/autoconsommation',
    label: 'Comprendre l’autoconsommation',
  },
  tilt: {
    step: 'a1',
    body: 'Autour de 30 à 35°, la production est à son maximum. Un toit très plat ou très pentu perd quelques pourcents, rarement davantage.',
    href: '/installation/fixation',
    label: 'Fixation et inclinaison',
  },
  shading: {
    step: 'a2',
    body: 'Une seule ombre peut pénaliser toute une chaîne de panneaux. Les micro-onduleurs limitent fortement la casse.',
    href: '/installation/ombrage',
    label: 'Gérer l’ombrage',
  },
  heatPump: {
    step: 'a3',
    body: 'Une pompe à chaleur consomme en journée pendant l’hiver : elle relève votre autoconsommation, donc vos économies.',
    href: '/installation/pompe-a-chaleur',
    label: 'Panneaux et pompe à chaleur',
  },
  car: {
    step: 'a4',
    body: 'Recharger en journée transforme un surplus injecté à bas prix en carburant quasi gratuit.',
    href: '/installation/voiture-electrique',
    label: 'Recharger sa voiture au solaire',
  },
  battery: {
    step: 'a5',
    body: 'Une batterie stocke le surplus du jour pour le soir. Elle change votre autoconsommation, jamais votre production.',
    href: '/comprendre/batterie',
    label: 'Faut-il une batterie ?',
  },
};
---

<section class="sim">
  {/* ⚠️ Réglages d'image IDENTIQUES à ceux de `PageHero` et `SliderCalculator` :
      à réglages égaux `astro:assets` réutilise le même fichier, alors que la
      moindre divergence génère en silence un second jeu complet de variantes.
      L'échelle monte à 2560 pour les écrans Retina.

      ⚠️ Photo empruntée au hero de la home faute de photo dédiée au simulateur :
      elle figure dans la liste « à fournir par le client ». */}
  <Image
    class="sim__image"
    src={heroImage}
    alt=""
    width={2560}
    widths={[768, 1280, 1920, 2560]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="sim__overlay" aria-hidden="true"></div>

  <div class="sim__panel">
    <h1 class="sim__h1">Ce que le solaire donnerait chez vous</h1>
    <p class="sim__lede">
      Quelques questions, une minute. Aucun compte, aucune coordonnée pour voir vos chiffres.
    </p>

  <div class="sim__body">
  {/* ⚠️ Un seul `<form>` englobe les deux rails : c'est ce qui fait que
      l'affinage « reprend les réponses déjà données » sans rien transférer. */}
  <form class="sim__form" data-sim-form>
    <SimulatorWizard
      kind="questions"
      steps={QUESTION_STEPS}
      finalLabel="Voir mon estimation"
      label="Les questions du simulateur"
    >
      {/* ⚠️ ÉTAPE CONDITIONNELLE. Elle n'apparaît que si la région est encore
          inconnue — ni code postal du hero, ni `?region=` d'un méga-menu, ni
          choix mémorisé. Sans elle, le simulateur retombait en silence sur la
          Wallonie, la seule des trois régions où l'installation ne s'amortit
          jamais : un Bruxellois lisait « au-delà de 25 ans » au lieu de
          « 4 à 8 ans ». Le script la retire dès que la région est connue. */}
      <SimulatorStep id="0" index={1} total={QUESTION_STEPS.length} title="Où se trouve le bâtiment ?">
        <div class="sim__field">
          <label class="sim__label" for="sim-cp">Code postal</label>
          <input
            class="sim__text" id="sim-cp" name="cp" type="text"
            inputmode="numeric" autocomplete="postal-code" maxlength="4"
            pattern="[0-9]{4}" placeholder="1000"
          />
          {/* Le retour immédiat : le visiteur VOIT que son code a été compris,
              et quelle région en découle. */}
          <p class="sim__hint" data-sim-region-echo>
            Les aides et le tarif d’injection changent du tout au tout selon la région.
          </p>
        </div>
      </SimulatorStep>

      <SimulatorStep id="1" index={2} total={QUESTION_STEPS.length} title="De quel bien s’agit-il ?">
        <fieldset class="sim__field">
          <legend class="visually-hidden">Type de bien</legend>
          <div class="sim__choices">
            {PROPERTY_TYPES.map((p) => (
              <label class="sim__choice">
                <input type="radio" name="property" value={p.value} />
                <span>{p.label}</span>
              </label>
            ))}
          </div>

          {/* ⚠️ Filtrer TÔT. `simulateur.md` pose le principe : laisser quelqu'un
              répondre à quatre questions de plus pour apprendre à la fin que le
              modèle ne s'applique pas à lui détruit la confiance. Le bouton
              devient une sortie vers l'équipe, pas une question suivante. */}
          <p class="sim__notice" data-sim-outofscope-step hidden>
            Un bâtiment professionnel se dimensionne autrement qu’une maison :
            notre estimation résidentielle ne s’y applique pas. Parlons-en
            directement avec vous.
          </p>
        </fieldset>
      </SimulatorStep>

      <SimulatorStep id="2" index={3} total={QUESTION_STEPS.length} title="Votre toiture est plutôt…">
        <fieldset class="sim__field">
          <legend class="visually-hidden">Type de toit</legend>
          <div class="sim__choices sim__choices--row">
            {ROOF_TYPES.map((r) => (
              <label class="sim__choice">
                <input type="radio" name="roof" value={r.value} />
                <span>{r.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </SimulatorStep>

      {/* ⚠️ DES BOUTONS, PAS UN CURSEUR. Le curseur du catalogue a été monté ici
          puis retiré : sur une question de parcours, quatre réponses nommées se
          lisent et se cliquent plus vite qu'un soleil qu'il faut déplacer pour
          découvrir ce qu'on choisit. La brique reste montée sur la page
          « Rendement », où elle a le temps d'expliquer — c'est là qu'elle sert. */}
      <SimulatorStep id="3" index={4} total={QUESTION_STEPS.length} title="Vers où regarde votre toit ?">
        <fieldset class="sim__field">
          <legend class="visually-hidden">Orientation principale</legend>
          <div class="sim__choices">
            {ORIENTATIONS.map((o) => (
              <label class="sim__choice">
                <input type="radio" name="orientation" value={o.value} />
                <span>{o.label}</span>
              </label>
            ))}
            {/* ⚠️ « Je ne sais pas » vaut Sud-Est/Sud-Ouest : une hypothèse
                prudente, jamais le plein sud qui flatterait le résultat. */}
            <label class="sim__choice">
              <input type="radio" name="orientation" value="sud-est-ouest" />
              <span>Je ne sais pas</span>
            </label>
          </div>
        </fieldset>
      </SimulatorStep>

      <SimulatorStep id="4" index={5} total={QUESTION_STEPS.length} title="Quelle surface pouvez-vous couvrir ?">
        <div class="sim__field">
          <label class="sim__label" for="sim-area">
            Surface disponible
            <output class="sim__value" data-sim-echo="area">{AREA_DEFAULT} m²</output>
          </label>
          <input
            class="sim__range" id="sim-area" name="area" type="range"
            min={AREA_MIN} max={AREA_MAX} step={AREA_STEP} value={AREA_DEFAULT}
          />
          {/* Le brief signale que peu de gens connaissent leurs m² : on donne un
              repère plutôt qu'un champ nu. */}
          <p class="sim__hint">Repère : une place de parking fait environ 12 m², un pan de toiture courant 30 à 50 m².</p>
        </div>
      </SimulatorStep>

      <SimulatorStep id="5" index={6} total={QUESTION_STEPS.length} title="Combien consommez-vous ?">
        <fieldset class="sim__field">
          <legend class="visually-hidden">Votre consommation</legend>
          <div class="sim__choices sim__choices--row">
            <label class="sim__choice">
              <input type="radio" name="consumptionMode" value="facture" />
              <span>Ma facture</span>
            </label>
            <label class="sim__choice">
              <input type="radio" name="consumptionMode" value="kwh" />
              <span>Mes kWh</span>
            </label>
            <label class="sim__choice">
              <input type="radio" name="consumptionMode" value="inconnue" />
              <span>Je ne sais pas</span>
            </label>
          </div>

          <div class="sim__sub" data-sim-mode="facture" hidden>
            <div class="sim__choices">
              {BILL_BANDS.map((b) => (
                <label class="sim__choice">
                  <input type="radio" name="bill" value={b.value} />
                  <span>{b.label}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="sim__sub" data-sim-mode="kwh" hidden>
            <label class="sim__label" for="sim-consumption">
              Consommation annuelle
              <output class="sim__value" data-sim-echo="consumption">{formatNumber(CONSUMPTION_DEFAULT)} kWh</output>
            </label>
            <input
              class="sim__range" id="sim-consumption" name="consumption" type="range"
              min={CONSUMPTION_MIN} max={CONSUMPTION_MAX} step={CONSUMPTION_STEP} value={CONSUMPTION_DEFAULT}
            />
          </div>

          <p class="sim__notice" data-sim-needsbill hidden>
            Nous n’avons pas de moyenne pour ce type de bien — indiquez votre facture
            pour obtenir une estimation.
          </p>
        </fieldset>
      </SimulatorStep>
    </SimulatorWizard>

    {/* --- L'affinage : cinq options de plus, le même résultat mis à jour ---
        ⚠️ 100 % OPTIONNEL. Le résultat est complet sans lui ; l'affinage ne fait
        que RESSERRER les fourchettes (`SPREAD_REFINED` contre `SPREAD_QUICK`).
        C'est le seul bénéfice promis, et il est mesurable. */}
    {/* ⚠️ PAS de `hidden` ici, volontairement : sans JavaScript, les cinq options
        restent atteignables en faisant défiler leur rail, comme les cinq
        questions. C'est le script qui masque ce parcours tant qu'on ne l'a pas
        demandé. (Un `hidden` posé sur le composant serait de toute façon resté
        sans effet : Astro ne reporte pas les attributs inconnus sur la racine.) */}
    <SimulatorWizard
      kind="affinage"
      steps={REFINE_STEPS}
      finalLabel="Mettre à jour mon estimation"
      label="Les cinq options d’affinage"
    >
      {/* Même parti que l'orientation : des réponses nommées, pas un curseur. */}
      <SimulatorStep id="a1" index={1} total={REFINE_STEPS.length} title="Quelle pente a votre toit ?">
        <fieldset class="sim__field">
          <legend class="visually-hidden">Inclinaison du toit</legend>
          <div class="sim__choices sim__choices--row">
            {TILTS.map((t) => (
              <label class="sim__choice">
                <input type="radio" name="tilt" value={t.value} />
                <span>{t.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </SimulatorStep>

      <SimulatorStep id="a2" index={2} total={REFINE_STEPS.length} title="Votre toit est-il ombragé ?">
        <fieldset class="sim__field">
          <legend class="visually-hidden">Ombrage</legend>
          <div class="sim__choices sim__choices--row">
            {SHADINGS.map((s) => (
              <label class="sim__choice">
                <input type="radio" name="shading" value={s.value} />
                <span>{s.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </SimulatorStep>

      <SimulatorStep id="a3" index={3} total={REFINE_STEPS.length} title="Avez-vous une pompe à chaleur ?">
        <fieldset class="sim__field">
          <legend class="visually-hidden">Pompe à chaleur</legend>
          <div class="sim__choices sim__choices--row">
            {YES_NO_SOON.map((o) => (
              <label class="sim__choice">
                <input type="radio" name="heatPump" value={o.value} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </SimulatorStep>

      <SimulatorStep id="a4" index={4} total={REFINE_STEPS.length} title="Roulez-vous à l’électrique ?">
        <fieldset class="sim__field">
          <legend class="visually-hidden">Voiture électrique</legend>
          <div class="sim__choices sim__choices--row">
            {YES_NO_SOON.map((o) => (
              <label class="sim__choice">
                <input type="radio" name="car" value={o.value} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </SimulatorStep>

      <SimulatorStep id="a5" index={5} total={REFINE_STEPS.length} title="Ajouter une batterie ?">
        <div class="sim__field">
          {/* Toggle produit : on l'active pour VOIR l'effet, pas pour cocher une
              case de formulaire. Ses deux états sont des réponses — c'est pour
              cela que cette étape ne verrouille jamais « Suivant ». */}
          <label class="sim__toggle">
            <input type="checkbox" name="battery" />
            <span class="sim__toggle-box" aria-hidden="true"></span>
            <span class="sim__toggle-copy">
              <strong>Ajouter une batterie domestique</strong>
              <em>Stocke le surplus du jour pour le soir : l’autoconsommation monte fortement.</em>
            </span>
          </label>
          {/* ⚠️ Le surcoût de la batterie n'est PAS modélisé — aucune source du
              projet ne le chiffre. On montre l'effet, et on le dit. */}
          <p class="sim__hint">
            Le budget affiché n’inclut pas la batterie : son coût se chiffre lors de l’étude.
          </p>
        </div>
      </SimulatorStep>
    </SimulatorWizard>
  </form>

    {/* ⚠️ L'AIDE VIT À CÔTÉ DU PARCOURS, pas dedans. Logée dans l'étape, elle
        défilait avec le rail et se faisait rogner par son découpage horizontal.
        Ici elle reste en place pendant que les questions glissent — et c'est
        aussi ce que fait le panneau latéral du wireframe `analyse-personnalisee`.

        ⚠️ Les onze blocs sont TOUS rendus au build ; le script n'affiche que
        celui de l'étape en cours. Sans JavaScript, l'aside se lit comme la liste
        des clarifications, en regard des onze questions du rail — le contenu vit
        dans le HTML, jamais dans le script (règle d'or #1).

        ⚠️ Les liens ouvrent un NOUVEL ONGLET : les réponses vivent dans le
        formulaire, pas dans l'URL. Quitter la page pour lever un doute les
        effacerait toutes. */}
    <aside class="sim__help" data-sim-help>
      {Object.values(HELP).map((help) => (
        <div class="sim__help-block" data-help={help.step}>
          <p class="sim__help-body">{help.body}</p>
          <a class="sim__help-link" href={help.href} target="_blank" rel="noopener">
            {help.label}
            <span class="visually-hidden"> (s’ouvre dans un nouvel onglet)</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      ))}
    </aside>
  </div>

    <SimulatorResult />

    <p class="visually-hidden" data-sim-status role="status" aria-live="polite"></p>
  </div>
</section>

<script>
  import { initSimulator } from '../scripts/simulatorWidget';
  initSimulator(document);
</script>

<style>
  /* --- La bande, calquée sur `.calc` de `SliderCalculator` --- */
  .sim {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--section-padding-block) var(--container-padding);
    overflow: hidden;
  }

  .sim__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }

  .sim__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--overlay-photo);
  }

  /* Le panneau de verre. Il ne prend PAS `--width-power-panel` (768px) : la
     question et son « en savoir plus » doivent tenir de front en desktop, ce que
     768px interdisent. On reprend l'esthétique du module, pas sa largeur. */
  .sim__panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--width-sim-panel);
    padding: var(--pad-power-panel);
    border-radius: var(--radius-panel);
    background: var(--bg-glass-fill-menu);
    backdrop-filter: blur(var(--bg-glass-blur-menu));
    border: var(--bg-glass-border);
  }

  .sim__h1 {
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line-height);
  }

  .sim__lede {
    color: var(--color-text-secondary);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
    line-height: var(--text-body-light-line-height);
  }

  /* Le corps : la carte du parcours, et l'aide qui l'accompagne. */
  .sim__body {
    display: grid;
    gap: var(--gap-cards);
    align-items: start;
    min-width: 0;
  }

  .sim__help {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  /* Le même garde-fou que partout ailleurs : `display: flex` l'emporterait sur
     la règle `[hidden] { display: none }` du navigateur. */
  .sim__help[hidden],
  .sim__help-block[hidden] {
    display: none;
  }

  .sim__help-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--pad-card);
    border-radius: var(--radius-card);
    background: var(--color-white-primary);
  }

  .sim__help-body {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line-height);
  }

  .sim__help-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    color: var(--color-text-secondary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }

  /* La carte blanche du module : c'est elle qui contient, le verre ne fait
     qu'encadrer. */
  .sim__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    /* ⚠️ `min-width: 0` sur un enfant de grille : par défaut il vaut `auto` et
       refuse de descendre sous la largeur intrinsèque de son contenu. Le rail
       porte onze étapes bout à bout — sans cette remise à zéro, la carte prenait
       leur largeur cumulée et débordait du panneau. */
    min-width: 0;
    padding: var(--pad-card-lg-block);
    border-radius: var(--radius-panel);
    background: var(--color-white-primary);
  }

  .sim__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-inline-size: 0;
    padding: 0;
    margin: 0;
    border: 0;
  }

  /* Voir le garde-fou de `SimulatorWizard` : `display: flex` l'emporterait sur
     la règle `[hidden] { display: none }` du navigateur. */
  .sim__sub[hidden],
