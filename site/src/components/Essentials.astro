---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import type { Bridge, Fact, Figure, SectionCopy } from '../data/content';

/**
 * « L'essentiel » — le bloc scannable et VISIBLE du gabarit
 * (`pages-contenu.md` §3, Figma 466:1400).
 *
 * C'est la colonne vertébrale de la page : ce que le visiteur pressé doit
 * pouvoir lire sans rien déplier ni manipuler. Rien de ce qui est ici ne doit
 * partir en accordéon — la profondeur, c'est le bloc suivant.
 *
 * Il se termine sur des ponts : ce que ce bloc ne dit PAS (les aides, le retour
 * sur investissement) et où aller le lire. Nommer explicitement l'angle mort
 * vaut mieux qu'un CTA générique — c'est la boucle contenu ↔ contenu.
 */
interface Props extends SectionCopy {
  /** Cartes chiffres : un cas, un ordre de grandeur. */
  figures: Figure[];
  /** Cartes texte : les conditions, en clair. */
  facts: Fact[];
  bridges: Bridge[];
}

const { overline, title, intro, figures, facts, bridges } = Astro.props;
---

<Section tone="default">
  <SectionHeading overline={overline} title={title} intro={intro} />

  <div class="essentials reveal">
    <ul class="essentials__figures">
      {figures.map((figure) => (
        <li class={`essentials__card essentials__card--${figure.tone}`}>
          <p class="essentials__label">{figure.label}</p>
          <p class="essentials__value">
            {figure.prefix && <span class="essentials__prefix">{figure.prefix}</span>}
            {figure.value}
          </p>
        </li>
      ))}
    </ul>

    <ul class="essentials__facts">
      {facts.map((fact) => (
        <li class="essentials__card essentials__card--grey">
          <h3 class="essentials__fact-title">{fact.title}</h3>
          <p class="essentials__fact-text">{fact.text}</p>
        </li>
      ))}
    </ul>

    <div class="essentials__bridges">
      {/* Décoratif : « i » dit à l'œil que ce panneau nuance ce qui précède.
          À l'oral, ce rôle est déjà tenu par les titres des deux colonnes. */}
      <span class="essentials__icon" aria-hidden="true">i</span>
      {bridges.map((bridge) => (
        <div class="essentials__bridge">
          <h3 class="essentials__bridge-title">{bridge.title}</h3>
          <p class="essentials__bridge-text">{bridge.text}</p>
          <Button variant="ink" href={bridge.cta.href} wrap>{bridge.cta.label}</Button>
        </div>
      ))}
    </div>
  </div>
</Section>

<style>
  .essentials {
    display: flex;
    flex-direction: column;
    gap: var(--gap-cards);
    width: 100%;
  }

  /* ⚠️ La grille NE CHANGE PAS entre mobile et desktop — trois chiffres de
     front, deux conditions côte à côte, aux deux tailles (Figma 466:1869).
     Les empiler sur mobile détruirait la seule chose que ce bloc sert à faire :
     comparer les fourchettes d'un coup d'œil. Ce qui s'adapte, ce sont les
     paddings, le rayon et la typographie. */
  .essentials__figures,
  .essentials__facts {
    display: grid;
    gap: var(--gap-cards);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .essentials__figures {
    grid-template-columns: repeat(3, 1fr);
  }

  .essentials__facts {
    grid-template-columns: repeat(2, 1fr);
  }

  .essentials__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    /* ⚠️ Sans cela, `1fr` ne rétrécit pas : un élément de grille a un
       `min-width: auto` implicite, et le montant en `nowrap` fixe alors la
       largeur minimale de sa colonne. Les trois cartes débordaient de la page
       en dessous de 360px sans qu'aucune règle ne paraisse fautive. */
    min-width: 0;
    /* Hauteur posée, pas déduite : c'est elle qui pousse le libellé en haut et
       la valeur en bas, et qui garantit que les trois cartes alignent leurs
       valeurs même quand un libellé passe à deux lignes. */
    min-height: var(--height-figure-card);
    border-radius: var(--radius-figure-card);
  }

  /* Les cartes chiffres se resserrent latéralement sur mobile (8px), pas les
     cartes conditions : les premières sont trois de front, les secondes deux. */
  .essentials__figures .essentials__card {
    padding: var(--pad-figure-block) var(--pad-figure-inline);
  }

  .essentials__facts .essentials__card {
    padding: var(--pad-card);
  }

  .essentials__card--grey {
    background: var(--color-shade-grey);
    color: var(--color-text-secondary);
  }

  .essentials__card--lime {
    background: var(--color-highlight-primary);
    color: var(--color-text-primary);
  }

  .essentials__card--ink {
    background: var(--color-ink-800);
    color: var(--color-white-clear);
  }

  /* --- Cartes chiffres --- */
  .essentials__label {
    font-family: var(--text-overline-family);
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    line-height: var(--text-overline-line-height);
    letter-spacing: var(--text-overline-tracking);
  }

  .essentials__card--ink .essentials__label {
    color: var(--color-shade-grey);
  }

  /* Fer à droite : les trois valeurs s'alignent alors sur un même bord, ce qui
     rend la progression des montants lisible d'un coup d'œil. Au fer à gauche,
     « 4 500 » et « 11 500 » ne commençaient pas au même endroit. */
  .essentials__value {
    text-align: end;
    font-family: var(--text-display-mid-family);
    font-size: var(--text-figure-value-size);
    font-weight: var(--text-display-mid-weight);
    line-height: var(--text-display-mid-line-height);
    letter-spacing: var(--text-display-mid-tracking);
    /* Trois colonnes sur un écran de 320px : « 11 500 € » y déborde de sa
       carte. Le montant reste d'un bloc et se réduit avec elle plutôt que de
       casser en deux lignes ou de sortir du cadre. */
    text-wrap: nowrap;
  }

  .essentials__prefix {
    display: block;
    font-family: var(--text-figure-prefix-family);
    font-size: var(--text-figure-prefix-size);
    font-weight: var(--text-figure-prefix-weight);
    line-height: var(--text-figure-prefix-line-height);
    letter-spacing: var(--text-body-bull-tracking);
  }

  /* --- Cartes conditions ---
     Deux styles MOBILES publiés par Figma (`h3-m`, `petit_p-m`), pas des
     réductions inventées. Le second change même de famille — Inter sur mobile,
     Circular sur desktop : à 14px le Circular Book perd sa lisibilité. */
  .essentials__fact-title {
    font-family: var(--text-h3-m-family);
    font-size: var(--text-h3-m-size);
    font-weight: var(--text-h3-m-weight);
    line-height: var(--text-h3-m-line-height);
    letter-spacing: var(--text-h3-m-tracking);
  }

  .essentials__fact-text {
    font-family: var(--text-petit-p-m-family);
    font-size: var(--text-petit-p-m-size);
    font-weight: var(--text-petit-p-m-weight);
    line-height: var(--text-petit-p-m-line-height);
    letter-spacing: var(--text-petit-p-m-tracking);
  }

  /* --- Panneau des ponts --- */
  .essentials__bridges {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding: var(--pad-card-lg-block);
    border-radius: var(--radius-panel);
    background: var(--color-white-clear);
  }

  .essentials__icon {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--space-24);
    height: var(--space-24);
    border: var(--border-width) solid var(--color-text-muted);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    line-height: 1;
  }

  .essentials__bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    padding: var(--pad-card-lg-block);
    text-align: center;
  }

  .essentials__bridge-title {
    font-family: var(--text-h4-family);
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
    line-height: var(--text-h4-line-height);
    letter-spacing: var(--text-h4-tracking);
    color: var(--color-text-primary);
  }

  /* Le bouton est poussé en pied de colonne : les deux s'alignent même quand un
     texte fait une ligne de plus que l'autre. */
  .essentials__bridge :global(.btn) {
    margin-top: auto;
  }

  .essentials__bridge-text {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-bull-family);
    font-size: var(--text-body-bull-size);
    font-weight: var(--text-body-bull-weight);
    line-height: var(--text-body-bull-line-height);
    letter-spacing: var(--text-body-bull-tracking);
  }

  /* Le panneau de ponts perd ses deux épaisseurs de 25px sur mobile
     (Figma 466:1893 : 8px). Cumulées à la marge de section, elles retiraient
     66px de chaque côté sur un écran de 320 — il ne restait pas de quoi poser
     un bouton. */
  @media (max-width: 767px) {
    .essentials__bridges {
      padding: var(--space-2);
      gap: var(--space-24);
    }

    .essentials__bridge {
      padding: var(--space-2);
    }
  }

  @media (min-width: 768px) {
    /* Les cartes conditions repassent au display : sur desktop elles portent
       assez de largeur pour que le Circular reste lisible, et le bloc retrouve
       la cohérence du reste de la page. */
    .essentials__fact-title {
      font-family: var(--text-h4-family);
      font-size: var(--text-h4-size);
      font-weight: var(--text-h4-weight);
      line-height: var(--text-h4-line-height);
      letter-spacing: var(--text-h4-tracking);
    }

    .essentials__fact-text {
      font-family: var(--text-body-bull-family);
      font-size: var(--text-body-bull-size);
      font-weight: var(--text-body-bull-weight);
      line-height: var(--text-body-bull-line-height);
      letter-spacing: var(--text-body-bull-tracking);
    }

    /* Seuls les ponts changent de grille : ils portent un titre, un paragraphe
       et un bouton — impossible à tenir sur une demi-colonne de téléphone. */
    .essentials__bridges {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
