---
import type { SvgComponent } from 'astro/types';
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import type {
  Bridge, EssentialsPanel, EssentialsTable, Fact, Figure, IconCard, PhotoCard, SectionCopy,
} from '../data/content';

/**
 * « L'essentiel » — le bloc scannable et VISIBLE du gabarit
 * (`pages-contenu.md` §3, Figma 466:1400).
 *
 * C'est la colonne vertébrale de la page : ce que le visiteur pressé doit
 * pouvoir lire sans rien déplier ni manipuler. Rien de ce qui est ici ne doit
 * partir en accordéon — la profondeur, c'est le bloc suivant.
 *
 * Il se termine sur des ponts : ce que ce bloc ne dit PAS (les aides, le retour
 * sur investissement) et où aller le lire. Nommer explicitement l'angle mort
 * vaut mieux qu'un CTA générique — c'est la boucle contenu ↔ contenu.
 */
interface Props extends SectionCopy {
  /**
   * Cartes chiffres : un cas, un ordre de grandeur.
   *
   * ⚠️ Peut être VIDE. Toutes les pages n'ont pas trois grandeurs à comparer —
   * certaines n'ont que des conditions en clair. Une liste vide rendue quand
   * même laissait une bande grise sans contenu au milieu de la section.
   */
  figures: Figure[];
  /** Cartes texte : les conditions, en clair. Peut être vide, comme `figures`. */
  facts: Fact[];
  bridges: Bridge[];

  /* ── Les quatre autres formes du même bloc ──────────────────────────────────
     ⚠️ ELLES S'EXCLUENT EN PRATIQUE, mais rien ne l'impose au type : une page
     peut légitimement garder UNE carte chiffre et poser le reste en `aside`
     (c'est le cas de Poids et d'Abri de jardin). Le choix se fait page par
     page, sur les cinq questions du cahier de correction — pas ici.

     Ce qu'aucune ne doit permettre : forcer trois cartes uniformes sur un
     contenu qui ne s'y prête pas. C'est cette contrainte-là qui a produit des
     « valeurs » comme « Capte » ou « Détaillé » posées en corps 44. */

  /** Trois objets photographiables. Deux cartes de front, ou 2+1 à trois. */
  photos?: PhotoCard[];
  /** Trois facettes qualitatives. L'icône est résolue par la page. */
  icons?: (IconCard & { icon?: SvgComponent })[];
  /** Une vraie comparaison : mêmes critères sur plusieurs objets. */
  table?: EssentialsTable;
  /** Un seul fait et ses conséquences, dans une carte unique. */
  panel?: EssentialsPanel;
  /**
   * Ce qui ne méritait pas une carte.
   *
   * Le débouché de la 5ᵉ question du cahier : un seul fait mérite la mise en
   * avant, le reste redescend en texte simple sous la grille. Deux paragraphes
   * au plus — au-delà, c'est le bloc « Creuser le sujet » qui prend le relais.
   */
  aside?: string[];
}

const {
  overline, title, intro, figures, facts, bridges,
  photos = [], icons = [], table, panel, aside = [],
} = Astro.props;
---

<Section tone="default">
  <SectionHeading overline={overline} title={title} intro={intro} />

  <div class="essentials reveal">
    {figures.length > 0 && (
    <ul class="essentials__figures" data-count={figures.length}>
      {figures.map((figure) => (
        <li class={`essentials__card essentials__card--${figure.tone}`}>
          <p class="essentials__label">{figure.label}</p>
          <p class="essentials__value">
            {figure.prefix && <span class="essentials__prefix">{figure.prefix}</span>}
            {figure.value}
          </p>
          {figure.note && <p class="essentials__note">{figure.note}</p>}
        </li>
      ))}
    </ul>
    )}

    {/* ⚠️ TROIS OBJETS, TROIS PHOTOS (Figma 695:490).
        Un cadre gris qui tient la grille, des cartes blanches dedans, et dans
        chaque carte le TEXTE À GAUCHE, LA PHOTO À DROITE. À trois cartes la
        grille passe en 2+1 : la troisième prend toute la largeur plutôt que
        d'ouvrir une colonne vide. À deux, deux colonnes égales — une asymétrie
        n'aurait rien à équilibrer. */}
    {photos.length > 0 && (
    <div class="essentials__board">
      <ul class="essentials__photos" data-count={photos.length}>
        {photos.map((photo) => (
          <li class="essentials__photo">
            <div class="essentials__photo-text">
              <h3 class="essentials__photo-title">{photo.title}</h3>
              <p class="essentials__photo-body">{photo.text}</p>
            </div>
            {/* Tant que la photo n'est pas livrée, l'emplacement se nomme. Une
                image de stock générique serait pire que le vide (`design.md`).

                ⚠️ `ratio="auto"` : ici la photo ne se donne pas une hauteur, elle
                REMPLIT celle de la carte. Un ratio imposé rouvrait l'écart que la
                hauteur commune vient de fermer. */}
            <div class="essentials__photo-media">
              <ImagePlaceholder label={photo.image} ratio="auto" />
            </div>
          </li>
        ))}
      </ul>
    </div>
    )}

    {/* Trois facettes d'un même sujet : l'icône remplace la valeur géante. */}
    {icons.length > 0 && (
    <ul class="essentials__icons">
      {icons.map((item) => (
        <li class="essentials__card essentials__card--grey essentials__icon-card">
          {item.icon && <item.icon class="essentials__icon-mark" aria-hidden="true" width={32} height={32} />}
          <h3 class="essentials__fact-title">{item.title}</h3>
          <p class="essentials__fact-text">{item.text}</p>
        </li>
      ))}
    </ul>
    )}

    {/* ⚠️ UN VRAI TABLEAU, avec ses en-têtes — pas une grille déguisée. Trois
        garanties comparées sur les mêmes critères se lisent en colonne ; en
        trois cartes séparées, le lien qui les rend comparables disparaît. */}
    {table && (
    <div class="essentials__table-wrap">
      <table class="essentials__table">
        <thead>
          <tr>{table.head.map((cell) => <th scope="col">{cell}</th>)}</tr>
        </thead>
        <tbody>
          {table.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    )}

    {/* Un seul fait, ses conséquences en dessous. */}
    {panel && (
    <div class="essentials__card essentials__card--lime essentials__panel">
      {panel.title && <h3 class="essentials__panel-title">{panel.title}</h3>}
      <ul class="essentials__panel-list">
        {panel.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    )}

    {/* Ce qui ne méritait pas une carte, sous la grille. */}
    {aside.length > 0 && (
    <div class="essentials__aside">
      {aside.map((text) => <p>{text}</p>)}
    </div>
    )}

    {facts.length > 0 && (
    <ul class="essentials__facts">
      {facts.map((fact) => (
        <li class="essentials__card essentials__card--grey">
          <h3 class="essentials__fact-title">{fact.title}</h3>
          <p class="essentials__fact-text">{fact.text}</p>
        </li>
      ))}
    </ul>
    )}

    <div class="essentials__bridges">
      {/* Décoratif : « i » dit à l'œil que ce panneau nuance ce qui précède.
          À l'oral, ce rôle est déjà tenu par les titres des deux colonnes. */}
      <span class="essentials__icon" aria-hidden="true">i</span>
      {bridges.map((bridge) => (
        <div class="essentials__bridge">
          <h3 class="essentials__bridge-title">{bridge.title}</h3>
          <p class="essentials__bridge-text">{bridge.text}</p>
          <Button variant="ink" href={bridge.cta.href} wrap>{bridge.cta.label}</Button>
        </div>
      ))}
    </div>
  </div>
</Section>

<style>
  .essentials {
    display: flex;
    flex-direction: column;
    gap: var(--gap-cards);
    width: 100%;
  }

  /* ⚠️ La grille NE CHANGE PAS entre mobile et desktop — trois chiffres de
     front, deux conditions côte à côte, aux deux tailles (Figma 466:1869).
     Les empiler sur mobile détruirait la seule chose que ce bloc sert à faire :
     comparer les fourchettes d'un coup d'œil. Ce qui s'adapte, ce sont les
     paddings, le rayon et la typographie. */
  .essentials__figures,
  .essentials__facts {
    display: grid;
    gap: var(--gap-cards);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .essentials__figures {
    grid-template-columns: repeat(3, 1fr);
  }

  /* ⚠️ LA GRILLE SUIT LE NOMBRE DE CARTES. Trois colonnes fixes étaient
     l'hypothèse de départ — celle qui a poussé des pages à inventer une
     troisième « valeur » pour remplir la ligne. Depuis qu'une page peut n'avoir
     qu'un seul vrai chiffre, la grille doit savoir compter : sans ces règles,
     une carte seule occupait un tiers de la largeur et deux cartes laissaient
     un trou à droite. */
  .essentials__figures[data-count='1'] {
    grid-template-columns: 1fr;
  }

  .essentials__figures[data-count='2'] {
    grid-template-columns: repeat(2, 1fr);
  }

  /* ⚠️ SEULE, LA CARTE CHANGE DE MISE EN PAGE. La colonne `space-between` des
     cartes chiffres suppose trois voisines : c'est elle qui pousse le libellé
     en haut et aligne les valeurs en pied. Étirée sur toute la largeur pour une
     carte unique, elle laissait un L de vide — libellé perdu en haut à gauche,
     chiffre en bas à droite, et rien entre les deux. En bandeau, le libellé
     tient la gauche et le chiffre la droite, sur la même ligne. */
  .essentials__figures[data-count='1'] .essentials__card {
    display: grid;
    grid-template-areas:
      'label value'
      'label note';
    grid-template-columns: 1fr auto;
    align-content: center;
    align-items: center;
    gap: 0 var(--space-3);
    min-height: 0;
    padding: var(--pad-card);
  }

  .essentials__figures[data-count='1'] .essentials__label {
    grid-area: label;
  }

  .essentials__figures[data-count='1'] .essentials__value {
    grid-area: value;
  }

  .essentials__figures[data-count='1'] .essentials__note {
    grid-area: note;
  }

  /* Sur téléphone la largeur manque pour deux colonnes : le bandeau redevient
     une carte, libellé au-dessus du chiffre. */
  @media (max-width: 767px) {
    .essentials__figures[data-count='1'] .essentials__card {
      grid-template-areas: 'label' 'value' 'note';
      grid-template-columns: 1fr;
      gap: var(--space-2) 0;
    }
  }

  .essentials__facts {
    grid-template-columns: repeat(2, 1fr);
  }

  .essentials__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    /* ⚠️ Sans cela, `1fr` ne rétrécit pas : un élément de grille a un
       `min-width: auto` implicite, et le montant en `nowrap` fixe alors la
       largeur minimale de sa colonne. Les trois cartes débordaient de la page
       en dessous de 360px sans qu'aucune règle ne paraisse fautive. */
    min-width: 0;
    /* Hauteur posée, pas déduite : c'est elle qui pousse le libellé en haut et
       la valeur en bas, et qui garantit que les trois cartes alignent leurs
       valeurs même quand un libellé passe à deux lignes. */
    min-height: var(--height-figure-card);
    border-radius: var(--radius-figure-card);
  }

  /* Les cartes chiffres se resserrent latéralement sur mobile (8px), pas les
     cartes conditions : les premières sont trois de front, les secondes deux. */
  .essentials__figures .essentials__card {
    padding: var(--pad-figure-block) var(--pad-figure-inline);
  }

  .essentials__facts .essentials__card {
    padding: var(--pad-card);
  }

  .essentials__card--grey {
    background: var(--color-shade-grey);
    color: var(--color-text-secondary);
  }

  .essentials__card--lime {
    background: var(--color-highlight-primary);
    color: var(--color-text-primary);
  }

  .essentials__card--ink {
    background: var(--color-ink-800);
    color: var(--color-white-clear);
  }

  /* --- Cartes chiffres --- */
  .essentials__label {
    font-family: var(--text-overline-family);
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    line-height: var(--text-overline-line-height);
    letter-spacing: var(--text-overline-tracking);
  }

  .essentials__card--ink .essentials__label {
    color: var(--color-shade-grey);
  }

  /* Fer à droite : les trois valeurs s'alignent alors sur un même bord, ce qui
     rend la progression des montants lisible d'un coup d'œil. Au fer à gauche,
     « 4 500 » et « 11 500 » ne commençaient pas au même endroit. */
  .essentials__value {
    text-align: end;
    font-family: var(--text-display-mid-family);
    font-size: var(--text-figure-value-size);
    font-weight: var(--text-display-mid-weight);
    line-height: var(--text-display-mid-line-height);
    letter-spacing: var(--text-display-mid-tracking);
    /* Trois colonnes sur un écran de 320px : « 11 500 € » y déborde de sa
       carte. Le montant reste d'un bloc et se réduit avec elle plutôt que de
       casser en deux lignes ou de sortir du cadre. */
    text-wrap: nowrap;
  }

  /* La condition qui restreint le chiffre, sous lui. Alignée sur la valeur et
     non sur le libellé : les deux forment une seule unité de lecture, que la
     `space-between` de la carte pousse déjà en bas.

     ⚠️ Elle ne rentre PAS dans `.essentials__value` : la valeur est en
     `nowrap` (voir la règle ci-dessus), et une condition de plusieurs mots y
     déborderait de la carte au lieu de passer à la ligne. */
  .essentials__note {
    text-align: end;
    font-family: var(--text-overline-family);
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    line-height: var(--text-overline-line-height);
    letter-spacing: var(--text-overline-tracking);
  }

  /* La carte sombre éclaircit sa condition comme elle éclaircit son libellé,
     sinon le gris secondaire par défaut y devient illisible. */
  .essentials__card--ink .essentials__note {
    color: var(--color-white-clear);
  }

  .essentials__prefix {
    display: block;
    font-family: var(--text-figure-prefix-family);
    font-size: var(--text-figure-prefix-size);
    font-weight: var(--text-figure-prefix-weight);
    line-height: var(--text-figure-prefix-line-height);
    letter-spacing: var(--text-body-bull-tracking);
  }

  /* --- Cartes conditions ---
     Deux styles MOBILES publiés par Figma (`h3-m`, `petit_p-m`), pas des
     réductions inventées. Le second change même de famille — Inter sur mobile,
     Circular sur desktop : à 14px le Circular Book perd sa lisibilité. */
  .essentials__fact-title {
    font-family: var(--text-h3-m-family);
    font-size: var(--text-h3-m-size);
    font-weight: var(--text-h3-m-weight);
    line-height: var(--text-h3-m-line-height);
    letter-spacing: var(--text-h3-m-tracking);
  }

  .essentials__fact-text {
    font-family: var(--text-petit-p-m-family);
    font-size: var(--text-petit-p-m-size);
    font-weight: var(--text-petit-p-m-weight);
    line-height: var(--text-petit-p-m-line-height);
    letter-spacing: var(--text-petit-p-m-tracking);
  }

  /* ── CARTES PHOTO (Figma 695:490) ────────────────────────────────────────
     Un cadre gris tient la grille, les cartes sont blanches dedans. C'est la
     recette du compte rendu du simulateur, appliquée ici : sans le cadre, trois
     cartes blanches posées sur un fond blanc n'auraient plus de contour. */
  .essentials__board {
    padding: var(--space-3);
    border-radius: var(--radius-panel);
    background: var(--color-shade-grey);
  }

  .essentials__photos {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ⚠️ TEXTE À GAUCHE, PHOTO À DROITE — pas la photo au-dessus. La maquette
     couche la carte : c'est ce qui lui donne sa hauteur contenue et permet d'en
     aligner trois. Empilées, les mêmes cartes faisaient 520 px de haut. */
  .essentials__photo {
    display: flex;
    gap: var(--space-3);
    align-items: stretch;
    justify-content: space-between;
    min-width: 0;
    padding: var(--space-3);
    border-radius: var(--radius-card);
    background: var(--color-white-primary);
  }

  /* Hauteur posée, comme les cartes chiffres : les textes vont de trois à six
     lignes, et sans elle la rangée serait bancale. */
  @media (min-width: 768px) {
    .essentials__photos {
      grid-template-columns: repeat(2, 1fr);
    }

    /* 2+1 : à trois éléments, le dernier prend la largeur entière. */
    .essentials__photos[data-count='3'] .essentials__photo:last-child {
      grid-column: 1 / -1;
    }

    .essentials__photo {
      min-height: var(--height-photo-card);
    }
  }

  .essentials__photo-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  /* `display-little` de la maquette : Circular Book 22/24. Ce n'est PAS le `h3`
     du système (Medium 22/26) — le titre d'une carte photo accompagne l'image,
     il ne la commande pas. */
  .essentials__photo-title {
    font-family: var(--text-display-little-family);
    font-size: var(--text-display-little-size);
    font-weight: var(--text-display-little-weight);
    line-height: var(--text-display-little-line-height);
    letter-spacing: var(--text-display-little-tracking);
  }

  .essentials__photo-body {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line-height);
    letter-spacing: var(--text-body-sm-tracking);
  }

  .essentials__photo-media {
    flex: 0 0 var(--width-photo-media);
    min-width: 0;
  }

  /* La carte pleine largeur ne donne pas 40 % à sa photo : ça ferait 460 px de
     large contre 220 aux deux autres, pour un contenu de même importance. */
  .essentials__photos[data-count='3'] .essentials__photo:last-child .essentials__photo-media {
    flex-basis: calc(var(--width-photo-media) - 10%);
  }

  /* La photo remplit la hauteur de la carte plutôt que de l'imposer. */
  .essentials__photo-media :global(.placeholder),
  .essentials__photo-media :global(img) {
    height: 100%;
    border-radius: var(--radius-card);
    object-fit: cover;
  }

  /* ⚠️ SUR TÉLÉPHONE LA CARTE SE REDRESSE. Couchée sur 358 px, la photo tombe à
     143 px de large : elle ne montre plus son objet, ce qui est toute sa raison
     d'être ici. Elle repasse au-dessus du texte, en panoramique. */
  @media (max-width: 767px) {
    .essentials__photo {
      flex-direction: column-reverse;
    }

    .essentials__photo-media {
      flex: none;
      aspect-ratio: 16 / 9;
    }

    /* Le texte des cartes photo prend le style des cartes conditions : c'est
       `petit_p-m`, le style que Figma publie POUR LE MOBILE (14/16). Les deux
       blocs se suivent sur un téléphone, à 15 px contre 14 ils se ressemblaient
       sans se répondre. */
    .essentials__photo-body {
      font-family: var(--text-petit-p-m-family);
      font-size: var(--text-petit-p-m-size);
      font-weight: var(--text-petit-p-m-weight);
      line-height: var(--text-petit-p-m-line-height);
      letter-spacing: var(--text-petit-p-m-tracking);
    }
  }

  /* ── CARTES ICÔNE ─────────────────────────────────────────────────────────
     ⚠️ ELLES S'EMPILENT SUR MOBILE, contrairement aux cartes chiffres qui
     restent trois de front. La raison qui interdit d'empiler les chiffres —
     comparer trois fourchettes d'un coup d'œil — ne s'applique pas ici : il n'y
     a rien à comparer, seulement trois paragraphes à lire. Trois colonnes de
     texte sur 390px les rendraient illisibles. */
  .essentials__icons {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-cards);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .essentials__icon-card {
    /* La hauteur posée des cartes chiffres n'a pas lieu d'être : rien à aligner
       en pied, le texte commande. */
    justify-content: flex-start;
    min-height: 0;
    gap: var(--space-3);
    padding: var(--pad-card);
  }

  .essentials__icon-mark {
    width: var(--space-4);
    height: var(--space-4);
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .essentials__icons {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── TABLEAU ──────────────────────────────────────────────────────────────
     ⚠️ Le conteneur défile, jamais la page (règle des tableaux larges). */
  .essentials__table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-figure-card);
    background: var(--color-shade-grey);
  }

  .essentials__table {
    width: 100%;
    border-collapse: collapse;
    /* En dessous, les colonnes se tassent au point d'être illisibles : c'est là
       que le conteneur prend le relais et défile. */
    min-width: 32rem;
    color: var(--color-text-secondary);
    font-family: var(--text-petit-p-m-family);
    font-size: var(--text-petit-p-m-size);
    line-height: var(--text-petit-p-m-line-height);
    text-align: start;
  }

  .essentials__table th,
  .essentials__table td {
    padding: var(--pad-card);
    text-align: start;
    vertical-align: top;
  }

  .essentials__table thead th {
    color: var(--color-text-primary);
    font-family: var(--text-overline-family);
    font-size: var(--text-overline-size);
    font-weight: var(--text-overline-weight);
    letter-spacing: var(--text-overline-tracking);
  }

  /* Le filet ne sépare que les lignes de données : sous l'en-tête il marquerait
     une bordure de tableau, alors qu'il ne sert qu'à suivre une ligne. */
  .essentials__table tbody tr + tr th,
  .essentials__table tbody tr + tr td {
    border-top: var(--border-width) solid var(--color-shade-strong);
  }

  .essentials__table tbody th {
    color: var(--color-text-primary);
    font-family: var(--text-h3-m-family);
    font-size: var(--text-h3-m-size);
    font-weight: var(--text-h3-m-weight);
    line-height: var(--text-h3-m-line-height);
  }

  /* ── CARTE UNIQUE À PLUSIEURS LIGNES ─────────────────────────────────────── */
  .essentials__panel {
    justify-content: flex-start;
    min-height: 0;
    gap: var(--space-3);
    padding: var(--pad-card);
  }

  .essentials__panel-title {
