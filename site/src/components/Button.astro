---
/**
 * Bouton pilule avec pastille flèche greffée à droite — motif signature repris
 * sur tous les CTA (design.md §5).
 *
 * primary   : pilule verte   → CTA principal
 * ink       : pilule sombre  → CTA sur fond clair coloré (lime, vert)
 * secondary : pilule contour, sans pastille → action de second rang
 *
 * La pastille est identique partout et ne bouge pas au survol : fond blanc,
 * flèche sombre. Seule la pilule change de couleur, et le libellé roule.
 */
interface Props {
  variant?: 'primary' | 'ink' | 'secondary';
  href?: string;
  type?: 'button' | 'submit';
  /**
   * Le libellé peut passer à la ligne.
   *
   * Réservé aux boutons qui remplissent une colonne étroite — les ponts de
   * « L'essentiel » sur téléphone, où « Voir les aides de ma région » dépasse à
   * lui seul la largeur disponible à 320px. La maquette mobile le pose ainsi
   * (Figma 466:1898, libellé sur deux lignes).
   *
   * Par défaut le libellé reste d'un bloc : un CTA de barre de navigation qui se
   * casse en deux perd sa forme de pilule.
   */
  wrap?: boolean;
  /**
   * Sens « retour » : la pastille passe à gauche et la flèche pointe en arrière.
   *
   * Le motif signature reste entier, simplement miroir — c'est la seule façon
   * d'avoir un vrai bouton de recul sans inventer un second vocabulaire.
   */
  back?: boolean;
}

/* Les attributs non déclarés (`data-*`, `aria-*`) sont reportés sur la pilule :
   le simulateur a besoin d'accrocher son parcours au CTA sans le recopier. */
const { variant = 'primary', href, type = 'button', wrap = false, back = false, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
const hasIcon = variant !== 'secondary';
---

<Tag class={`btn btn--${variant} ${wrap ? 'btn--wrap' : ''} ${back ? 'btn--back' : ''}`} href={href} type={href ? undefined : type} {...rest}>
  {/* Deux niveaux : le cadre coupe, la ligne se déplace à l'intérieur. */}
  <span class="btn__label">
    <span class="btn__label-line"><slot /></span>
  </span>
  {hasIcon && (
    <span class="btn__icon" aria-hidden="true">
      <svg class="btn__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M2 7H12M12 7L7.5 2.5M12 7L7.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  )}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-button);
    border-radius: var(--radius-pill);
    font-family: var(--text-button-family);
    font-size: var(--text-button-size);
    font-weight: var(--text-button-weight);
    line-height: var(--text-button-line-height);
    letter-spacing: var(--text-button-tracking);
    text-decoration: none;
    cursor: pointer;
    border: none;
    white-space: nowrap;
    padding: var(--pad-button-edge) var(--pad-button-edge) var(--pad-button-edge)
      var(--pad-button-start);
    /* Angles de la flèche, au repos et à l'appui. En variables pour que la
       variante miroir n'ait que deux valeurs à redéfinir, sans dupliquer les
       six règles d'état plus bas. */
    --btn-arrow-rest: 0deg;
    --btn-arrow-hover: -45deg;

    background: var(--btn-bg);
    color: var(--btn-fg);
    /* Filet, et non une ombre : le système n'en a aucune. `outline` plutôt que
       `border` — une bordure élargirait le bouton de 2px et rognerait le champ
       du formulaire du hero, dont la largeur est contrainte. Décalage négatif
       pour que le trait tombe DANS la pilule et en épouse le rayon. */
    outline: var(--border-width) solid var(--btn-edge, transparent);
    outline-offset: calc(-1 * var(--border-width));
    transition:
      outline-color var(--duration-fast) var(--easing-default),
      background-color var(--duration-fast) var(--easing-default),
      color var(--duration-fast) var(--easing-default),
      transform var(--duration-fast) var(--easing-default);
  }

  /* --- Palettes : seule la pilule s'inverse au survol --- */

  /* Seule variante à en avoir besoin : le vert plein se pose sur des fonds
     clairs — verre du hero, blanc des sections — où son bord se dissout. Les
     variantes sombres se détachent d'elles-mêmes, et `secondary` a déjà un
     contour. */
  .btn--primary {
    --btn-edge: var(--color-main-green-edge);
    --btn-bg: var(--color-main-green);
    --btn-fg: var(--color-text-primary);
    --btn-bg-active: var(--color-text-primary);
    --btn-fg-active: var(--color-white-primary);
  }

  /* Cette variante ne change pas de couleur au survol : elle se pose sur des
     fonds déjà colorés — carte lime de l'équipe, section grise du processus,
     carte verte du CTA final. Un basculement vers le vert s'y confondrait avec
     le fond. Seuls le roulement du libellé et la flèche marquent le survol. */
  .btn--ink {
    --btn-bg: var(--color-ink-900);
    --btn-fg: var(--color-text-inverted);
    --btn-bg-active: var(--color-ink-900);
    --btn-fg-active: var(--color-text-inverted);
  }

  .btn--secondary {
    --btn-bg: transparent;
    --btn-fg: var(--color-text-primary);
    --btn-bg-active: var(--color-text-primary);
    --btn-fg-active: var(--color-white-primary);

    border: var(--border-width) solid var(--color-shade-grey);
    padding: var(--space-12) var(--pad-button-start);
    transition:
      background-color var(--duration-fast) var(--easing-default),
      color var(--duration-fast) var(--easing-default),
      border-color var(--duration-fast) var(--easing-default);
  }

  /* --- Libellé : cadre de coupe + ligne mobile --- */

  .btn__label {
    display: block;
    overflow: hidden;
    /* Figma pose `leading-[normal]` sur le libellé du bouton, et non le
       rapport 1 du style `button`. Nécessaire ici : à 1, le cadre de coupe
       rognerait les jambages des lettres p, q et j. */
    line-height: normal;
  }

  .btn--primary .btn__label {
    flex: 1;
    text-align: center;
  }

  .btn__label-line {
    display: block;
  }

  /* Le roulement reste intact sur deux lignes : la course vaut 115 % de la
     HAUTEUR de la ligne, qui grandit avec elle — c'est tout le bloc qui monte,
     pas la première ligne seule. Le cadre de coupe suit de même. */
  .btn--wrap {
    white-space: normal;
  }

  /* Sans cela, la pilule garderait la largeur de son libellé au lieu de
     remplir la colonne — et un libellé qui a le droit de se casser mais pas de
     place où le faire ne se casse jamais. */
  .btn--wrap .btn__label {
    flex: 1;
  }

  /* --- Pastille : identique au repos et au survol --- */

  .btn__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--size-button-icon);
    height: var(--size-button-icon);
    border-radius: var(--radius-pill);
    flex-shrink: 0;
    background: var(--color-white-primary);
    color: var(--color-text-primary);
  }

  .btn__arrow {
    transform: rotate(var(--btn-arrow-rest));
    transition: transform var(--duration-fast) var(--easing-default);
  }

  /* --- Miroir : le recul ---
     `row-reverse` fait passer la pastille à gauche ; le rembourrage suit, sinon
     la pilule serait creuse d'un côté et serrée de l'autre. Les deux angles
     restent séparés de 45° : c'est le même geste, retourné. */
  .btn--back {
    flex-direction: row-reverse;
    padding: var(--pad-button-edge) var(--pad-button-start) var(--pad-button-edge)
      var(--pad-button-edge);
    --btn-arrow-rest: -180deg;
    --btn-arrow-hover: -135deg;
  }

  /* --- État actif ---
     `:focus-visible` est isolé dans ses propres règles : un sélecteur inconnu
     du navigateur invalide TOUTE la liste où il figure, ce qui supprimerait
     aussi le survol.

     `:active` accompagne `:hover` — règle d'or #6, pas d'interaction au survol
     seul : l'effet doit exister au clavier et au doigt. */
  /* L'enfoncement se lit sur le bouton entier : le libellé et la pastille
     suivent, comme une vraie pression. */
  .btn:hover,
  .btn:active {
    /* La pilule passe au sombre : elle se détache seule, le filet n'a plus
       lieu d'être. */
    --btn-edge: transparent;
    background: var(--btn-bg-active);
    color: var(--btn-fg-active);
    transform: scale(var(--btn-press-scale));
  }

  .btn:focus-visible {
    --btn-edge: transparent;
    background: var(--btn-bg-active);
    color: var(--btn-fg-active);
    transform: scale(var(--btn-press-scale));
  }

  .btn--secondary:hover,
  .btn--secondary:active {
    border-color: var(--btn-bg-active);
  }

  .btn--secondary:focus-visible {
    border-color: var(--btn-bg-active);
  }

  .btn:hover .btn__arrow,
  .btn:active .btn__arrow {
    transform: rotate(var(--btn-arrow-hover));
  }

  .btn:focus-visible .btn__arrow {
    transform: rotate(var(--btn-arrow-hover));
  }

  /* `label-roll` vit dans global.css : le même geste sert les liens des
     méga-menus. Le cadre de coupe et `line-height: normal` sont posés plus haut
     sur `.btn__label`, c'est ce que l'animation attend de son appelant. */
  .btn:hover .btn__label-line,
  .btn:active .btn__label-line {
    animation: label-roll var(--duration-roll);
  }

  .btn:focus-visible .btn__label-line {
    animation: label-roll var(--duration-roll);
  }

  @media (max-width: 767px) {
    .btn:hover,
    .btn:active,
    .btn:focus-visible {
      transform: none;
    }

    .btn:hover .btn__arrow,
    .btn:active .btn__arrow,
    .btn:focus-visible .btn__arrow {
      transform: rotate(var(--btn-arrow-rest));
    }

    .btn:hover .btn__label-line,
    .btn:active .btn__label-line,
    .btn:focus-visible .btn__label-line {
      animation: none;
    }
  }

  /* L'inversion de couleur porte le message à elle seule : on retire le
     mouvement, pas le retour visuel. */
  @media (prefers-reduced-motion: reduce) {
    .btn:hover,
    .btn:active,
    .btn:focus-visible {
      transform: none;
    }

    .btn:hover .btn__arrow,
    .btn:active .btn__arrow {
      transform: rotate(var(--btn-arrow-rest));
    }

    .btn:focus-visible .btn__arrow {
      transform: rotate(var(--btn-arrow-rest));
    }

    .btn:hover .btn__label-line,
    .btn:active .btn__label-line,
    .btn:focus-visible .btn__label-line {
      animation: none;
    }
  }
</style>
