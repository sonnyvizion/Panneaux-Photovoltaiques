---
interface Props {
  variant?: 'primary' | 'secondary';
  href?: string;
  type?: 'button' | 'submit';
}

const { variant = 'primary', href, type = 'button' } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class={`btn btn--${variant}`} href={href} type={href ? undefined : type}>
  <span class="btn__label"><slot /></span>
  {variant === 'primary' && (
    <span class="btn__icon" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M2 7H12M12 7L7.5 2.5M12 7L7.5 11.5" stroke="var(--color-bg)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  )}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    border-radius: var(--radius-pill);
    font-family: 'Circular Std', system-ui, sans-serif;
    font-weight: 500;
    font-size: 16px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-5);
    transition: opacity 150ms ease;
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-text);
  }

  .btn--secondary {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: var(--space-3) var(--space-5);
  }

  .btn__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--color-text);
  }

  .btn:active {
    opacity: 0.85;
  }

  .btn:hover:not(:active) {
    opacity: 0.9;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
