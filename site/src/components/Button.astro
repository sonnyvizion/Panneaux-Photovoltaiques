---
/**
 * Bouton pilule avec pastille flèche greffée à droite — motif signature repris
 * sur tous les CTA (design.md §5).
 *
 * primary   : pilule verte   → CTA principal
 * ink       : pilule sombre  → CTA sur fond clair coloré (lime, vert)
 * secondary : pilule contour, sans pastille → action de second rang
 *
 * La pastille est identique partout et ne bouge pas au survol : fond blanc,
 * flèche sombre. Seule la pilule change de couleur, et le libellé roule.
 */
interface Props {
  variant?: 'primary' | 'ink' | 'secondary';
  href?: string;
  type?: 'button' | 'submit';
}

const { variant = 'primary', href, type = 'button' } = Astro.props;
const Tag = href ? 'a' : 'button';
const hasIcon = variant !== 'secondary';
---

<Tag class={`btn btn--${variant}`} href={href} type={href ? undefined : type}>
  {/* Deux niveaux : le cadre coupe, la ligne se déplace à l'intérieur. */}
  <span class="btn__label">
    <span class="btn__label-line"><slot /></span>
  </span>
  {hasIcon && (
    <span class="btn__icon" aria-hidden="true">
      <svg class="btn__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M2 7H12M12 7L7.5 2.5M12 7L7.5 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  )}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-button);
    border-radius: var(--radius-pill);
    font-family: var(--text-button-family);
    font-size: var(--text-button-size);
    font-weight: var(--text-button-weight);
    line-height: var(--text-button-line-height);
    letter-spacing: var(--text-button-tracking);
    text-decoration: none;
    cursor: pointer;
    border: none;
    white-space: nowrap;
    padding: var(--pad-button-edge) var(--pad-button-edge) var(--pad-button-edge)
      var(--pad-button-start);

    background: var(--btn-bg);
    color: var(--btn-fg);
    transition:
      background-color var(--duration-fast) var(--easing-default),
      color var(--duration-fast) var(--easing-default);
  }

  /* --- Palettes : seule la pilule s'inverse au survol --- */

  .btn--primary {
    --btn-bg: var(--color-main-green);
    --btn-fg: var(--color-text-primary);
    --btn-bg-active: var(--color-text-primary);
    --btn-fg-active: var(--color-white-primary);
  }

  /* Cette variante ne change pas de couleur au survol : elle se pose sur des
     fonds déjà colorés — carte lime de l'équipe, section grise du processus,
     carte verte du CTA final. Un basculement vers le vert s'y confondrait avec
     le fond. Seuls le roulement du libellé et la flèche marquent le survol. */
  .btn--ink {
    --btn-bg: var(--color-ink-900);
    --btn-fg: var(--color-text-inverted);
    --btn-bg-active: var(--color-ink-900);
    --btn-fg-active: var(--color-text-inverted);
  }

  .btn--secondary {
    --btn-bg: transparent;
    --btn-fg: var(--color-text-primary);
    --btn-bg-active: var(--color-text-primary);
    --btn-fg-active: var(--color-white-primary);

    border: var(--border-width) solid var(--color-shade-grey);
    padding: var(--space-12) var(--pad-button-start);
    transition:
      background-color var(--duration-fast) var(--easing-default),
      color var(--duration-fast) var(--easing-default),
      border-color var(--duration-fast) var(--easing-default);
  }

  /* --- Libellé : cadre de coupe + ligne mobile --- */

  .btn__label {
    display: block;
    overflow: hidden;
    /* Figma pose `leading-[normal]` sur le libellé du bouton, et non le
       rapport 1 du style `button`. Nécessaire ici : à 1, le cadre de coupe
       rognerait les jambages des lettres p, q et j. */
    line-height: normal;
  }

  .btn__label-line {
    display: block;
  }

  /* --- Pastille : identique au repos et au survol --- */

  .btn__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--size-button-icon);
    height: var(--size-button-icon);
    border-radius: var(--radius-pill);
    flex-shrink: 0;
    background: var(--color-white-primary);
    color: var(--color-text-primary);
  }

  .btn__arrow {
    transition: transform var(--duration-fast) var(--easing-default);
  }

  /* --- État actif ---
     `:focus-visible` est isolé dans ses propres règles : un sélecteur inconnu
     du navigateur invalide TOUTE la liste où il figure, ce qui supprimerait
     aussi le survol.

     `:active` accompagne `:hover` — règle d'or #6, pas d'interaction au survol
     seul : l'effet doit exister au clavier et au doigt. */
  .btn:hover,
  .btn:active {
    background: var(--btn-bg-active);
    color: var(--btn-fg-active);
  }

  .btn:focus-visible {
    background: var(--btn-bg-active);
    color: var(--btn-fg-active);
  }

  .btn--secondary:hover,
  .btn--secondary:active {
    border-color: var(--btn-bg-active);
  }

  .btn--secondary:focus-visible {
    border-color: var(--btn-bg-active);
  }

  .btn:hover .btn__arrow,
  .btn:active .btn__arrow {
    transform: rotate(-45deg);
  }

  .btn:focus-visible .btn__arrow {
    transform: rotate(-45deg);
  }

  /* Le libellé sort par le haut, réapparaît par le bas et se repose avec un
     léger dépassement. Une seule ligne suffit : le saut du haut vers le bas se
     fait hors du cadre, à mi-parcours, donc invisible. */
  @keyframes btn-label-roll {
    0% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.4, 0, 1, 1);
    }
    49.9% {
      transform: translateY(calc(var(--btn-label-lift) * -1));
    }
    50% {
      transform: translateY(var(--btn-label-lift));
      animation-timing-function: var(--easing-bounce);
    }
    100% {
      transform: translateY(0);
    }
  }

  .btn:hover .btn__label-line,
  .btn:active .btn__label-line {
    animation: btn-label-roll var(--duration-roll);
  }

  .btn:focus-visible .btn__label-line {
    animation: btn-label-roll var(--duration-roll);
  }

  /* L'inversion de couleur porte le message à elle seule : on retire le
     mouvement, pas le retour visuel. */
  @media (prefers-reduced-motion: reduce) {
    .btn:hover .btn__arrow,
    .btn:active .btn__arrow {
      transform: none;
    }

    .btn:focus-visible .btn__arrow {
      transform: none;
    }

    .btn:hover .btn__label-line,
    .btn:active .btn__label-line,
    .btn:focus-visible .btn__label-line {
      animation: none;
    }
  }
</style>
