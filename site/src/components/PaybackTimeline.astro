---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import PaybackChart from './PaybackChart.astro';
import { POWER_DEFAULT } from '../scripts/powerEstimate';
import { REGION_DEFAULT } from '../scripts/savings';
import type { ContentLink, SectionCopy } from '../data/content';

/**
 * La coquille de section qui monte la timeline d'amortissement sur une page de
 * contenu. Le graphe lui-même vit dans `PaybackChart`, parce que le simulateur
 * le monte aussi — c'est le contrat du catalogue de briques.
 *
 * ⚠️ AUCUNE ENTRÉE UTILISATEUR ICI, et c'est délibéré : règle d'or #3, un seul
 * simulateur. Le module illustre le cas standard, calculé AU BUILD ; il ne
 * calcule pas le projet du visiteur, il l'envoie au simulateur pour cela.
 * `interactivite-seo.md` le classe d'ailleurs en « anim au scroll-in », pas en
 * brique à curseur.
 */
interface Props extends SectionCopy {
  /** Ce que le pont promet, sous le schéma. */
  bridgeLabel: string;
  cta: ContentLink;
}

const { overline, title, intro, bridgeLabel, cta } = Astro.props;
---

<Section tone="grey">
  <SectionHeading overline={overline} overlineTone="tertiary" title={title} intro={intro} />

  <div class="payback reveal">
    <PaybackChart kwc={POWER_DEFAULT} region={REGION_DEFAULT} />

    <div class="payback__bridge">
      <p class="payback__bridge-label">{bridgeLabel}</p>
      <Button href={cta.href}>{cta.label}</Button>
    </div>
  </div>
</Section>

<style>
  .payback {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--width-timeline);
    margin-inline: auto;
    padding: var(--pad-card-lg-block);
    border-radius: var(--radius-panel);
    background: var(--color-white-primary);
  }

  .payback__bridge {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    text-align: center;
  }

  .payback__bridge :global(.btn) {
    justify-content: center;
  }

  .payback__bridge-label {
    font-family: var(--text-h4-family);
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
    line-height: var(--text-h4-line-height);
    letter-spacing: var(--text-h4-tracking);
  }

  @media (min-width: 768px) {
    .payback__bridge {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: start;
    }
  }

  @media (max-width: 767px) {
    .payback {
      padding: var(--space-12);
      gap: var(--space-3);
    }
  }
</style>
