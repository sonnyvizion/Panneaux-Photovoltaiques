---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import enphaseLogo from '../assets/reassurance/enphase-logo.png';
import { MONTH_LABELS, KWH_PER_KWC_YEAR, POWER_DEFAULT, SUMMER_WINTER_RATIO } from '../scripts/powerEstimate';
import { GRID_CO2_G_PER_KWH, formatCo2 } from '../scripts/co2';
import { ELECTRICITY_PRICE, REGION_DEFAULT, SELF_CONSUMPTION_RATE, regionLabel } from '../scripts/savings';
import { formatEuro, formatNumber } from '../scripts/format';
import PaybackChart from './PaybackChart.astro';
import {
  AREA_DEFAULT,
  CONSUMPTION_DEFAULT,
  aidesLabel,
  outcomeProfile,
  simulate,
  type Range,
} from '../scripts/simulator';

/**
 * Le résultat — la récompense de la cinquième question.
 *
 * ⚠️ TOUT EN FOURCHETTES. Le détail précis reste la valeur de l'étude
 * personnalisée : c'est l'option A validée avec le client.
 *
 * ⚠️ CE QU'ON NE MONTRE PAS, sur consigne du brief : le nombre exact de
 * panneaux, le tableau de ROI année par année, le devis chiffré. Tout ce qui
 * permettrait de faire le projet seul ou d'aller comparer ailleurs.
 *
 * ⚠️ LES CHIFFRES RENDUS AU BUILD SONT UN EXEMPLE, PAS UNE ESTIMATION.
 * Depuis que plus rien n'est pré-coché dans le parcours, ce panneau ne peut pas
 * prétendre parler du visiteur tant qu'il n'a pas répondu. Il porte donc une
 * étiquette explicite, que le script retire au moment où les vraies réponses
 * arrivent. C'est ce que voit un visiteur sans JavaScript — un cas médian
 * honnêtement nommé — et la règle d'or #1 est tenue : le chiffre vit dans le
 * HTML, pas dans le script.
 */

const initial = simulate({
  region: REGION_DEFAULT,
  property: 'maison',
  roof: 'inclinee',
  orientation: 'sud',
  area: AREA_DEFAULT,
  consumptionMode: 'facture',
  bill: '100-200',
  consumption: CONSUMPTION_DEFAULT,
});

/* Arrondi au demi-cent : une estimation en fourchette n'a pas la précision de
   l'euro, et l'afficher serait la surjouer. */
const euro = (r: Range) =>
  `${formatEuro(Math.round(r.low / 50) * 50)} – ${formatEuro(Math.round(r.high / 50) * 50)}`;
const kwh = (r: Range) =>
  `${formatNumber(Math.round(r.low / 50) * 50)} – ${formatNumber(Math.round(r.high / 50) * 50)} kWh`;
const kwc = (r: Range) =>
  `${r.low.toFixed(1).replace('.', ',')} – ${r.high.toFixed(1).replace('.', ',')} kWc`;
const years = (r: Range | null) => (r === null ? 'au-delà de 25 ans' : `${r.low} – ${r.high} ans`);

const peak = Math.max(...initial.monthly);

/* Le profil du cas médian : c'est la variante de conversion que voit un visiteur
   sans JavaScript, et celle que le script remplacera dès la première réponse. */
const initialProfile = outcomeProfile(initial);
---

<section class="result" data-sim-result aria-labelledby="resultat-titre">
  {/* ─────────────────────────────────────────────── 1 · LE VERDICT ───────
      La ligne de tête, et immédiatement sous elle ce qui l'EXPLIQUE. La phrase
      régionale traînait au milieu de l'écran, entre la courbe et les barres,
      là où plus personne ne la reliait au chiffre. En Wallonie elle dit
      pourtant l'essentiel : « le tarif prosumer est déjà déduit des économies ».
      C'est la réponse à la question que pose le chiffre. */}
  <header class="result__head">
    <h2 class="result__title" id="resultat-titre" tabindex="-1">Votre estimation</h2>
    <p class="result__headline" data-sim-out="savings">{euro(initial.savings)} / an</p>
    <p class="result__unit">d’économies sur votre facture d’électricité</p>
    <p class="result__aides" data-sim-aides>{aidesLabel(REGION_DEFAULT)}</p>

    {/* Retiré par le script dès la première réponse du visiteur. */}
    <p class="result__example" data-sim-example>
      Exemple pour une maison en <span data-sim-example-region>{regionLabel(REGION_DEFAULT)}</span> :
      toit incliné plein sud, {AREA_DEFAULT} m², facture de 100 à 200 €/mois.
      Répondez aux questions pour obtenir la vôtre.
    </p>

    <p class="result__outofscope" data-sim-outofscope hidden>
      Un bâtiment professionnel se dimensionne autrement qu’une maison — notre
      estimation résidentielle ne s’y applique pas.
      <a href="/contact">Parlons-en directement.</a>
    </p>
  </header>

  {/* ──────────────────────────────────────── 2 · LE DIMENSIONNEMENT ───────
      ⚠️ NI les économies NI le temps de retour ici : les premières occupent la
      ligne de tête, le second vit dans la timeline. Les répéter donnait le même
      chiffre à trois endroits.

      ⚠️ AUCUNE TUILE EN LIME : l'accent de l'écran est descendu sur
      l'amortissement. Un seul lime par écran, sinon il ne désigne plus rien. */}
  <section class="result__block">
    <h3 class="result__block-title">L’installation qu’il vous faut</h3>
    <dl class="result__metrics">
      <div class="result__metric">
        <dt>Puissance recommandée</dt>
        <dd data-sim-out="kwc">{kwc(initial.kwc)}</dd>
      </div>
      <div class="result__metric">
        <dt>Production annuelle</dt>
        <dd data-sim-out="production">{kwh(initial.production)}</dd>
      </div>
      <div class="result__metric">
        <dt>Budget indicatif</dt>
        <dd data-sim-out="cost">{euro(initial.cost)}</dd>
      </div>
    </dl>
  </section>

  {/* ────────────────────────────────────────── 3 · LA RENTABILITÉ ─────────
      ⚠️ LA BRIQUE DU CATALOGUE, à son poste. `interactivite-seo.md` lui assigne
      le rôle « Résultats (ROI) » depuis le début.

      ⚠️ Le tracé est indicatif, le TEXTE porte la fourchette : le script écrit
      « 4 – 8 ans » dans la lecture chiffrée, pas l'année exacte que dessine la
      courbe. Le résultat reste en fourchettes, décision validée avec le client. */}
  <section class="result__block">
    <h3 class="result__block-title">Quand rentrez-vous dans vos frais&nbsp;?</h3>
    <PaybackChart
      kwc={POWER_DEFAULT}
      region={REGION_DEFAULT}
      live
      showCost={false}
      hypotheses={false}
      plot={false}
    />
  </section>

  {/* ─────────────────────────────────── 4 · LA PRODUCTION DANS L'ANNÉE ────
      ⚠️ Les barres n'avaient ni échelle ni interprétation : on voyait une forme,
      pas une quantité, et rien ne disait à quoi elle sert. Le repère haut donne
      l'ordre de grandeur, la phrase relie le graphique au reste du site — c'est
      l'écart été/hiver qui explique pourquoi le surplus part au réseau, donc
      pourquoi l'autoconsommation décide de la rentabilité. */}
  <section class="result__block">
    <h3 class="result__block-title">La production dans l’année</h3>
    <figure class="result__monthly" data-sim-monthly>
      <div class="result__plot">
        <p class="result__peak" aria-hidden="true">
          <span data-sim-peak>{formatNumber(Math.round(peak / 10) * 10)}</span> kWh
        </p>
        <div class="result__bars" aria-hidden="true">
          {MONTH_LABELS.map((label, index) => (
            <span class="result__bar" data-sim-bar style={`--bar: ${(initial.monthly[index] / peak) * 100}%`}>
              <span class="result__bar-label">
                <span class="result__bar-short">{label.slice(0, 1)}</span>
                <span class="result__bar-long">{label}</span>
              </span>
            </span>
          ))}
        </div>
      </div>
      <figcaption>
        Un mois d’été produit environ {SUMMER_WINTER_RATIO.toFixed(1).replace('.', ',')} fois
        plus qu’un mois d’hiver. C’est ce creux qui envoie le surplus d’été au
        réseau — et pourquoi consommer sa propre production change tout au calcul.
      </figcaption>
    </figure>
  </section>

  {/* ────────────────────────────────────────────────── 5 · LA SUITE ───────
      ⚠️ UNE SEULE ACTION PRINCIPALE, CHOISIE SELON LE RÉSULTAT.

      L'écran en proposait cinq de front — deux boutons pleins concurrents, deux
      liens et une sortie d'édition — là où le brief demande « CTA primaire
      dominant, CTA secondaire en texte plus petit, sans bouton concurrent ».
      Pire : il poussait « réservez votre étude » à un visiteur dont
      l'installation ne s'amortit pas sur 25 ans.

      Les quatre variantes sont rendues EN HTML au build, le script en révèle
      une (`outcomeProfile`). Sans JavaScript, celle du cas médian reste visible
      et la page tient debout — règle d'or #1.

      ⚠️ Le bouton « Recevoir mon devis » a disparu : doublon fonctionnel de
      l'étude, et `funnel.md` tranche — « CTA = étude personnalisée, pas devis ». */}
  <section class="result__next">
    <div class="result__outcome" data-sim-outcome="chaud" hidden={initialProfile !== 'chaud'}>
      <p class="result__pitch">Vos chiffres sont bons. Faites-les vérifier gratuitement.</p>
      <p class="result__sub">Nos experts certifiés Enphase confirment la puissance et le prix exact, sur place, sans engagement.</p>
      <Button href="/etude">Réserver mon étude gratuite</Button>
      <a class="result__second" href="/rapport" data-sim-report-link>Recevoir cette estimation par e-mail</a>
    </div>

    <div class="result__outcome" data-sim-outcome="tiede" hidden={initialProfile !== 'tiede'}>
      <p class="result__pitch">Votre projet tient, mais le retour dépend de vos usages.</p>
      <p class="result__sub">Cinq questions de plus resserrent la fourchette — un chauffage ou une voiture électriques changent nettement le calcul.</p>
      <Button href="/etude">Réserver mon étude gratuite</Button>
      <button class="result__second" type="button" data-sim-refine-open>Affiner mon estimation →</button>
    </div>

    {/* ⚠️ Le profil froid ne reçoit PAS de bouton d'étude en primaire. Pousser un
        rendez-vous commercial sur un résultat qui ne s'amortit pas serait
        exactement le travers d'intermédiaire que le positionnement du site
        refuse. On propose le levier qui peut réellement changer le verdict. */}
    <div class="result__outcome" data-sim-outcome="froid" hidden={initialProfile !== 'froid'}>
      <p class="result__pitch">En l’état, cette installation ne se rembourse pas sur 25 ans.</p>
      <p class="result__sub">Ce n’est pas forcément un non : une puissance mieux calibrée, ou une consommation déplacée vers la journée, retourne souvent le calcul. Précisez votre situation avant de décider.</p>
      <Button href="#" variant="ink" data-sim-refine-open>Affiner mon estimation</Button>
      <a class="result__second" href="/contact">En parler à un conseiller</a>
    </div>

    <div class="result__outcome" data-sim-outcome="hors-perimetre" hidden={initialProfile !== 'hors-perimetre'}>
      <p class="result__pitch">Un bâtiment professionnel se dimensionne autrement.</p>
      <p class="result__sub">Notre modèle résidentiel ne s’y applique pas — et publier un chiffre faux ne vous rendrait pas service.</p>
      <Button href="/contact">Parler à un conseiller</Button>
    </div>

    <div class="result__reassurance">
      {/* ⚠️ RATIO NATIF. Le fichier est un pictogramme de 259×267 — quasi carré.
          Il était déclaré en 96×28 : `astro:assets` produisait une variante
          écrasée, et le logo s'affichait comme une barre noire. La hauteur suit
          le token de certification, la largeur suit l'image. */}
      <Image src={enphaseLogo} alt="Installateur certifié Enphase" width={27} height={28} class="result__enphase" />
      <p>Installateur certifié Enphase · vous parlez à l’équipe qui pose vos panneaux.</p>
    </div>
  </section>

  {/* ──────────────────────────────────────── 6 · LE PIED UTILITAIRE ───────
      Des OUTILS, pas des offres. Détachés du bloc de conversion, en retrait :
      c'est ce qui rend l'action principale lisible comme la seule. */}
  <footer class="result__tools">
    <p class="result__mention">
      Estimation indicative basée sur des moyennes régionales. Nos experts certifiés
      Enphase l’affinent <strong>gratuitement</strong> avec une étude personnalisée.
    </p>

    <div class="result__links">
      {/* Le parcours remplace les questions par le résultat : sans cette sortie, une
          réponse mal cliquée serait irrattrapable autrement qu'en rechargeant. */}
      <button class="result__link" type="button" data-sim-edit hidden>← Modifier mes réponses</button>
      <button class="result__link" type="button" data-sim-refine-open data-sim-refine-tool>Affiner mon estimation →</button>
    </div>

    <details class="result__assumptions">
      <summary>Hypothèses de calcul</summary>
      <ul>
        <li>Productible : {KWH_PER_KWC_YEAR} kWh par kWc et par an, corrigé de l’orientation.</li>
        <li>Autoconsommation : {Math.round(SELF_CONSUMPTION_RATE * 100)} % par défaut (source CWaPE).</li>
        <li>Électricité à {ELECTRICITY_PRICE.toFixed(2).replace('.', ',')} €/kWh, vérifié en 2026.</li>
        <li>Facteur d’émission du réseau belge : ~{GRID_CO2_G_PER_KWH} g CO₂/kWh (source Elia).</li>
        <li>Dégradation des panneaux : 0,5 % par an.</li>
        <li>CO₂ évité : <span data-sim-out="co2">{formatCo2(initial.co2Kg)}</span> par an.</li>
      </ul>
    </details>
  </footer>
</section>

<style>
  /* ⚠️ LE COMPTE RENDU N'EST PLUS UNE CARTE. C'était une carte blanche posée
     dans le panneau de verre, et douze blocs y étaient empilés avec le MÊME
     écart : rien ne disait où un sujet finissait et où le suivant commençait.
     C'est de là que venait l'impression de confusion, bien plus que du décor.

     Il devient un document : des blocs titrés, séparés par un vrai silence
     (`--space-64`), sur le fond uni de la page. */
  .result {
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
    max-width: var(--width-sim-panel);
    margin-inline: auto;
  }

  /* Le verdict : titre, chiffre, unité, explication — empilés, pas répartis sur
     une ligne. La valeur est le sommet de l'écran, elle prend la largeur. */
  .result__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .result__unit {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
    font-weight: var(--text-body-light-weight);
    line-height: var(--text-body-light-line-height);
  }

  /* Un bloc = un sujet, avec son titre. */
  .result__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .result__block-title {
    font-family: var(--text-h4-family);
    font-size: var(--text-h4-size);
    font-weight: var(--text-h4-weight);
    line-height: var(--text-h4-line-height);
  }

  /* ⚠️ PAS de `tabular-nums` : dans Circular Std la chasse tabulaire élargit
     aussi l'espace et le tiret, et « 200 € – 300 € » s'y délite. */
  .result__headline {
    font-family: var(--text-display-mid-family);
    font-size: var(--text-h3-size);
    color: var(--color-text-primary);
    font-weight: var(--text-display-mid-weight);
    line-height: 1;
    letter-spacing: var(--text-display-mid-tracking);
    white-space: nowrap;
  }

  /* Voir le même garde-fou dans `SimulatorWizard` : `display: flex` l'emporterait
     sur la règle `[hidden] { display: none }` du navigateur. */
  .result[hidden] {
    display: none;
  }

  .result__title {
    font-size: var(--text-h3-size);
    line-height: var(--text-h3-line-height);
  }

  /* Le titre reçoit le focus à l'apparition du résultat : sans `outline: none`,
     un anneau surgirait sur un élément que personne n'a cliqué. Le repère visuel
     est ici le panneau lui-même, qui vient d'apparaître. */
  .result__title:focus {
    outline: none;
  }

  .result__example {
    padding: var(--space-3);
    border-radius: var(--radius-card);
    background: var(--color-white-clear);
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-utility-mobile-size);
    line-height: var(--text-body-sm-line-height);
  }

  .result__outofscope {
    padding: var(--space-3);
    border-radius: var(--radius-card);
    background: var(--color-white-clear);
    color: var(--color-text-secondary);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
    line-height: var(--text-body-light-line-height);
  }

  /* ⚠️ UNE ENTORSE ASSUMÉE À LA RÈGLE DU MODULE. `SliderCalculator` garde ses
     tuiles « de front à TOUTES les tailles » parce qu'elles portent des nombres
     courts (« 12 », « 6 500 € »). Les nôtres portent des FOURCHETTES
     (« 6 400 € – 9 600 € ») : cinq de front à 390px seraient illisibles. Le
     bandeau se replie donc, et c'est un choix, pas un oubli. */
  /* ⚠️ LE BANDEAU A SAUTÉ. Un fond `white-clear` tenait les tuiles ensemble tant
     que le compte rendu était une carte blanche. Sur une page qui est ELLE-MÊME
     en `white-clear`, il ne sépare plus rien : il ne restait qu'un niveau
     d'emboîtement de plus. Les tuiles se tiennent maintenant seules, par leur
     filet — c'est la profondeur du système (aucune ombre n'existe ici). */
  .result__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--width-sim-metric), 1fr));
    gap: var(--gap-cards);
    margin: 0;
  }

  .result__metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    /* Sans `min-width: 0`, la valeur impose sa largeur à la colonne et les
       tuiles débordent de la grille. */
    min-width: 0;
    padding: var(--space-24) var(--space-3);
    border: var(--border-width) solid var(--color-shade-grey);
    border-radius: var(--radius-card);
    background: var(--color-white-primary);
    text-align: center;
    background: var(--color-white-primary);
  }

  .result__metric--accent {
    background: var(--color-highlight-primary);
  }

  .result__metric dt {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
  }

  .result__metric--accent dt {
    color: var(--color-text-secondary);
  }

  .result__metric dd {
    margin: 0;
    font-family: var(--text-display-mid-family);
    font-size: var(--text-power-value-size);
    font-weight: var(--text-display-mid-weight);
    line-height: 1.05;
    letter-spacing: var(--text-display-mid-tracking);
  }

  .result__aides:empty {
    display: none;
  }

  .result__aides {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-body-sm-size);
    line-height: var(--text-body-sm-line-height);
  }

  .result__monthly {
    display: flex;
    flex-direction: column;
    /* L'écart laisse passer les étiquettes de mois, posées en absolu SOUS les
       barres : sans lui, la légende viendrait s'écrire par-dessus. */
    gap: var(--space-24);
    padding: var(--space-24) var(--space-3) var(--space-3);
    border: var(--border-width) solid var(--color-shade-grey);
    border-radius: var(--radius-card);
    background: var(--color-white-primary);
  }

  .result__monthly figcaption {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-light-family);
    font-size: var(--text-body-light-size);
    font-weight: var(--text-body-light-weight);
    line-height: var(--text-body-light-line-height);
  }

  /* ⚠️ LE REPÈRE HAUT MANQUAIT. Douze barres sans échelle montrent une FORME,
     pas une quantité : on voyait que l'été produit plus, sans savoir combien.
     Un seul repère suffit — le mois le plus fort borne la lecture, et une
     graduation fine promettrait une précision que l'estimation n'a pas. */
  .result__plot {
    position: relative;
    padding-top: var(--space-24);
  }

  .result__peak {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-utility-mobile-size);
    line-height: 1;
  }

  .result__bars {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: end;
    gap: var(--gap-sim-bars);
    height: var(--height-sim-bars);
    /* Le trait du haut matérialise le repère : sans lui, le chiffre flotte. */
    border-top: var(--border-width) solid var(--color-shade-grey);
  }

  .result__bar {
    position: relative;
    display: block;
    height: var(--bar);
    border-radius: var(--radius-1) var(--radius-1) 0 0;
    background: var(--color-ink-700);
    transition: height var(--duration-fast) var(--easing-default);
  }

  /* ⚠️ CONTRASTE. Les étiquettes étaient en `--color-text-muted` (#a4acac) sur
     blanc, à 10px : `design.md` signale déjà UN point du site sous le seuil AA,
     il n'était pas question d'en ajouter douze. `text-tertiary` (#4c5250) passe
     largement. */
  .result__bar-label {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    padding-top: var(--space-1);
    text-align: center;
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-micro-size);
    line-height: 1;
  }

  /* À 390px, douze fois « Jan Fév Mar… » se chevauchent : chaque colonne fait
     moins de 25px. L'initiale tient, et l'ordre des mois fait le reste. */
  .result__bar-short {
    display: none;
  }

  @media (max-width: 767px) {
    .result__bar-short {
      display: inline;
    }

    .result__bar-long {
      display: none;
    }
  }

  .result__reassurance {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border-radius: var(--radius-card);
    background: var(--color-white-clear);
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-utility-mobile-size);
    line-height: var(--text-body-sm-line-height);
  }

  .result__enphase {
    flex-shrink: 0;
    width: auto;
    height: var(--size-certif-logo-sm);
    object-fit: contain;
  }

  .result__mention {
    color: var(--color-text-tertiary);
    font-family: var(--text-body-sm-family);
    font-size: var(--text-utility-mobile-size);
    line-height: var(--text-body-sm-line-height);
  }

