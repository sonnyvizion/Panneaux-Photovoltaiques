  }

  .header__list.has-shell .header__panel-menu {
    -webkit-backdrop-filter: none;
  }

  .header__panel {
    -webkit-backdrop-filter: blur(var(--bg-glass-blur-menu));
  }

  .header__burger,
  .header__call {
    -webkit-backdrop-filter: blur(var(--bg-glass-blur));
  }
