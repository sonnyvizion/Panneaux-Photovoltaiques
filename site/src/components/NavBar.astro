  .header__link:focus-visible,
  .header__summary:focus-visible,
  .header__utility-item:focus-visible,
  .header__burger:focus-visible,
  .header__call:focus-visible,
  .header__panel-link:focus-visible,
  .header__group-link:focus-visible,
  .header__panel-sublink:focus-visible,
  .header__overview:focus-visible,
  .header__ramp:focus-visible {
