    .header__utility-start {
      flex: 1;
    }

    .header__utility-end {
      flex-shrink: 0;
    }

    .header__region {
      display: none;
    }

    .header__phone {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

