  /* Panneau plein écran. `100dvh` et non `100vh` : sur mobile, la barre d'URL
     se rétracte au défilement et `vh` fige la hauteur d'avant, laissant une
     bande morte en bas. */
  .header__panel {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    height: 100dvh;
    padding: var(--space-2);
