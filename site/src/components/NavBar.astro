  .header__panel-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Le soulignement descend sur la ligne animée, comme pour les rampes : posé
     sur le lien, il resterait immobile pendant que le texte roule. */
  .header__panel-sublink--all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    text-decoration: none;
  }

  .header__panel-sublink--all .header__roll {
