  .header__panel-region {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    cursor: pointer;
    color: var(--color-text-primary);
    font-family: var(--text-body-nav-family);
    font-size: var(--text-body-nav-size);
    font-weight: var(--text-body-nav-weight);
  }

  .header__panel-locales {
    display: flex;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__panel-locale {
    color: var(--color-text-primary);
    text-decoration: none;
    font-family: var(--text-body-nav-family);
    font-size: var(--text-body-nav-size);
    font-weight: var(--text-body-nav-weight);
  }

  .header__panel-locale:not(.is-active) {
    opacity: var(--opacity-muted);
  }

  .header__panel-locale.is-active {
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }

  .header__panel-cta {
    display: flex;
    padding: var(--space-3);
  }

  /* ⚠️ Nom DISTINCT de `header__panel-foot`, qui appartient au pied des
